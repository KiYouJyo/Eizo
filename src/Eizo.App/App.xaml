<Application x:Class="Eizo.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
        <ResourceDictionary Source="Themes/Colors.xaml" />
        <ResourceDictionary Source="Themes/Typography.xaml" />
        <ResourceDictionary Source="Themes/Controls.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- Keep NavigationView content native. Only shell/transient surfaces are
           overridden, matching SpatialViewer's live Light/Dark behavior. -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="ShellNavigationPaneBackgroundBrush"
                           Color="Transparent" />
          <SolidColorBrush x:Key="AppTransientSurfaceBrush"
                           Color="#E5F9F9" />
          <StaticResource x:Key="AppTransientSurfaceBorderBrush"
                          ResourceKey="CardStrokeColorDefaultBrush" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="ShellNavigationPaneBackgroundBrush"
                           Color="Transparent" />
          <SolidColorBrush x:Key="AppTransientSurfaceBrush"
                           Color="#1A2323" />
          <StaticResource x:Key="AppTransientSurfaceBorderBrush"
                          ResourceKey="CardStrokeColorDefaultBrush" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
          <SolidColorBrush x:Key="ShellNavigationPaneBackgroundBrush"
                           Color="{ThemeResource SystemColorWindowColor}" />
          <StaticResource x:Key="AppTransientSurfaceBrush"
                          ResourceKey="SystemColorWindowBrush" />
          <StaticResource x:Key="AppTransientSurfaceBorderBrush"
                          ResourceKey="CardStrokeColorDefaultBrush" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
