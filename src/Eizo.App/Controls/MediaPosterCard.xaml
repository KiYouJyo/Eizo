<UserControl x:Class="Eizo.Controls.MediaPosterCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             UseLayoutRounding="True">
  <Border Style="{StaticResource MediaPosterCardRootStyle}">
    <Grid RowDefinitions="272,124">
      <Border Style="{StaticResource MediaPosterArtworkStyle}">
        <Grid>
          <FontIcon Glyph="{x:Bind IconGlyph, Mode=OneWay}"
                    FontSize="48"
                    Opacity="0.18"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
          <Image Source="{x:Bind Artwork, Mode=OneWay}"
                 Stretch="UniformToFill" />
          <Border Style="{StaticResource MediaPosterBadgeStyle}"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Top"
                  Margin="8">
            <TextBlock Text="{x:Bind BadgeText, Mode=OneWay}"
                       FontSize="11"
                       FontWeight="SemiBold" />
          </Border>
        </Grid>
      </Border>

      <StackPanel Grid.Row="1"
                  Padding="11,9,11,10"
                  Spacing="4">
        <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                   Style="{StaticResource MediaPosterTitleTextStyle}" />
        <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}"
                   Style="{StaticResource MediaPosterSecondaryTextStyle}" />
        <TextBlock Text="{x:Bind MetaLine, Mode=OneWay}"
                   Style="{StaticResource MediaPosterMetaTextStyle}" />
        <TextBlock x:Name="FooterTextBlock"
                   Text="{x:Bind FooterLine, Mode=OneWay}"
                   Style="{StaticResource MediaPosterFooterTextStyle}"
                   Visibility="Collapsed" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
