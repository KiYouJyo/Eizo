<UserControl x:Class="Eizo.Views.BangumiSubjectDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer Background="Transparent"
                HorizontalScrollMode="Disabled"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalContentAlignment="Stretch">
    <Grid x:Name="DetailRoot"
          Padding="24,16,24,32"
          RowDefinitions="Auto,18,*"
          HorizontalAlignment="Stretch"
          UseLayoutRounding="True">
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup>
          <VisualState x:Name="DetailCompact">
            <VisualState.StateTriggers>
              <AdaptiveTrigger MinWindowWidth="0" />
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter Target="PosterBorder.Visibility"
                      Value="Collapsed" />
              <Setter Target="DetailContent.(Grid.Column)"
                      Value="0" />
              <Setter Target="DetailContent.(Grid.ColumnSpan)"
                      Value="2" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="DetailWide">
            <VisualState.StateTriggers>
              <AdaptiveTrigger MinWindowWidth="760" />
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter Target="PosterBorder.Visibility"
                      Value="Visible" />
              <Setter Target="DetailContent.(Grid.Column)"
                      Value="1" />
              <Setter Target="DetailContent.(Grid.ColumnSpan)"
                      Value="1" />
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>

      <Grid ColumnDefinitions="*,Auto"
            ColumnSpacing="10">
        <TextBlock x:Name="PageTitle"
                   Style="{StaticResource PageTitleText}" />
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8">
          <ProgressRing x:Name="LoadingRing"
                        Width="22"
                        Height="22"
                        IsActive="False"
                        Visibility="Collapsed"
                        VerticalAlignment="Center" />
          <Button x:Name="RefreshButton"
                  Click="RefreshButton_Click" />
          <Button x:Name="OpenBangumiButton"
                  Click="OpenBangumiButton_Click" />
        </StackPanel>
      </Grid>

      <Grid Grid.Row="2"
            ColumnDefinitions="240,*"
            ColumnSpacing="24">
        <Border x:Name="PosterBorder"
                Width="220"
                Height="314"
                CornerRadius="12"
                Background="{ThemeResource EizoSelectionBrush}"
                VerticalAlignment="Top">
          <Grid>
            <FontIcon Glyph="&#xE8B2;"
                      FontSize="52"
                      Opacity="0.18" />
            <Image x:Name="PosterImage"
                   Stretch="UniformToFill" />
          </Grid>
        </Border>

        <StackPanel x:Name="DetailContent"
                    Grid.Column="1"
                    Spacing="12">
          <TextBlock x:Name="TitleText"
                     FontSize="28"
                     FontWeight="SemiBold"
                     TextWrapping="Wrap" />
          <TextBlock x:Name="NativeTitleText"
                     Style="{StaticResource BodyText}"
                     TextWrapping="Wrap" />
          <TextBlock x:Name="MetaText"
                     Style="{StaticResource MetadataText}"
                     TextWrapping="Wrap" />
          <TextBlock x:Name="StatusText"
                     Style="{StaticResource MetadataText}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                     TextWrapping="Wrap" />

          <Grid Margin="0,2,0,0"
                ColumnDefinitions="*,Auto"
                ColumnSpacing="12">
            <TextBlock x:Name="CollectionStateStatusText"
                       Style="{StaticResource MetadataText}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />
            <Border Grid.Column="1"
                    HorizontalAlignment="Right"
                    CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
              <Grid x:Name="CollectionStateButtons"
                    ColumnDefinitions="Auto,Auto,Auto,Auto,Auto">
                <ToggleButton x:Name="CollectionWishButton"
                              Grid.Column="0"
                              MinWidth="66"
                              Height="34"
                              Padding="10,0"
                              CornerRadius="7,0,0,7"
                              BorderThickness="0"
                              Tag="1"
                              Click="CollectionStateButton_Click" />
                <ToggleButton x:Name="CollectionDoneButton"
                              Grid.Column="1"
                              MinWidth="66"
                              Height="34"
                              Padding="10,0"
                              CornerRadius="0"
                              BorderThickness="0"
                              Tag="2"
                              Click="CollectionStateButton_Click" />
                <ToggleButton x:Name="CollectionDoingButton"
                              Grid.Column="2"
                              MinWidth="66"
                              Height="34"
                              Padding="10,0"
                              CornerRadius="0"
                              BorderThickness="0"
                              Tag="3"
                              Click="CollectionStateButton_Click" />
                <ToggleButton x:Name="CollectionOnHoldButton"
                              Grid.Column="3"
                              MinWidth="66"
                              Height="34"
                              Padding="10,0"
                              CornerRadius="0"
                              BorderThickness="0"
                              Tag="4"
                              Click="CollectionStateButton_Click" />
                <ToggleButton x:Name="CollectionDroppedButton"
                              Grid.Column="4"
                              MinWidth="66"
                              Height="34"
                              Padding="10,0"
                              CornerRadius="0,7,7,0"
                              BorderThickness="0"
                              Tag="5"
                              Click="CollectionStateButton_Click" />
              </Grid>
            </Border>
          </Grid>

          <Border Height="1"
                  Margin="0,2"
                  Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

          <TextBlock x:Name="SummaryTitle"
                     Style="{StaticResource SectionTitleText}" />
          <TextBlock x:Name="SummaryText"
                     Style="{StaticResource BodyText}"
                     TextWrapping="Wrap"
                     MaxWidth="860"
                     HorizontalAlignment="Left" />

          <TextBlock x:Name="TagsTitle"
                     Margin="0,8,0,0"
                     Style="{StaticResource SectionTitleText}" />
          <TextBlock x:Name="TagsText"
                     Style="{StaticResource MetadataText}"
                     TextWrapping="Wrap"
                     MaxWidth="860"
                     HorizontalAlignment="Left" />

          <Border Height="1"
                  Margin="0,8,0,0"
                  Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

          <Pivot x:Name="CommunityPivot"
                 Margin="0,2,0,0">
            <PivotItem x:Name="CommentsTab">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="10">
                  <TextBlock x:Name="CommentsStatusText"
                             Style="{StaticResource MetadataText}"
                             TextWrapping="Wrap"
                             VerticalAlignment="Center" />
                  <ComboBox x:Name="CommentsFilterCombo"
                            Grid.Column="1"
                            MinWidth="128"
                            SelectionChanged="CommentsFilterCombo_SelectionChanged" />
                </Grid>

                <ItemsControl x:Name="CommentsList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Margin="0,0,0,10"
                              Padding="12"
                              CornerRadius="10"
                              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                              BorderThickness="1">
                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="10">
                          <Border Width="40"
                                  Height="40"
                                  CornerRadius="20"
                                  Background="{ThemeResource EizoSelectionBrush}">
                            <Grid>
                              <FontIcon Glyph="&#xE77B;"
                                        FontSize="18"
                                        Opacity="0.28" />
                              <Image Source="{Binding Avatar}"
                                     Stretch="UniformToFill" />
                            </Grid>
                          </Border>
                          <StackPanel Grid.Column="1"
                                      Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                              <TextBlock Text="{Binding UserName}"
                                         FontWeight="SemiBold" />
                              <Button Grid.Column="1"
                                      Padding="8,2"
                                      Content="{Binding ReactionText}"
                                      IsEnabled="{Binding CanReact}"
                                      Tag="{Binding}"
                                      Click="CommentReactionButton_Click" />
                            </Grid>
                            <TextBlock Text="{Binding MetaLine}"
                                       Style="{StaticResource MetadataText}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding CommentText}"
                                       Style="{StaticResource BodyText}"
                                       TextWrapping="Wrap" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button x:Name="CommentsLoadMoreButton"
                        HorizontalAlignment="Center"
                        Visibility="Collapsed"
                        Click="CommentsLoadMoreButton_Click" />
              </StackPanel>
            </PivotItem>

            <PivotItem x:Name="ReviewsTab">
              <StackPanel Spacing="10">
                <TextBlock x:Name="ReviewsStatusText"
                           Style="{StaticResource MetadataText}"
                           TextWrapping="Wrap" />

                <ItemsControl x:Name="ReviewsList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              Padding="0"
                              Margin="0,0,0,10"
                              Tag="{Binding Review}"
                              Click="ReviewItem_Click">
                        <Border Padding="12"
                                CornerRadius="10"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                          <Grid ColumnDefinitions="Auto,*"
                                ColumnSpacing="10">
                            <Border Width="40"
                                    Height="40"
                                    CornerRadius="20"
                                    Background="{ThemeResource EizoSelectionBrush}">
                              <Grid>
                                <FontIcon Glyph="&#xE77B;"
                                          FontSize="18"
                                          Opacity="0.28" />
                                <Image Source="{Binding Avatar}"
                                       Stretch="UniformToFill" />
                              </Grid>
                            </Border>
                            <StackPanel Grid.Column="1"
                                        Spacing="4">
                              <TextBlock Text="{Binding Title}"
                                         FontWeight="SemiBold"
                                         TextWrapping="Wrap" />
                              <TextBlock Text="{Binding UserName}"
                                         Style="{StaticResource MetadataText}" />
                              <TextBlock Text="{Binding Summary}"
                                         Style="{StaticResource BodyText}"
                                         MaxLines="4"
                                         TextTrimming="CharacterEllipsis"
                                         TextWrapping="Wrap" />
                              <TextBlock Text="{Binding MetaLine}"
                                         Style="{StaticResource MetadataText}" />
                            </StackPanel>
                          </Grid>
                        </Border>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button x:Name="ReviewsLoadMoreButton"
                        HorizontalAlignment="Center"
                        Visibility="Collapsed"
                        Click="ReviewsLoadMoreButton_Click" />
              </StackPanel>
            </PivotItem>

            <PivotItem x:Name="TopicsTab">
              <StackPanel Spacing="10">
                <TextBlock x:Name="TopicsStatusText"
                           Style="{StaticResource MetadataText}"
                           TextWrapping="Wrap" />

                <ItemsControl x:Name="TopicsList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              Padding="0"
                              Margin="0,0,0,10"
                              Tag="{Binding Topic}"
                              Click="TopicItem_Click">
                        <Border Padding="12"
                                CornerRadius="10"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                          <StackPanel Spacing="4">
                            <TextBlock Text="{Binding Title}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding UserName}"
                                       Style="{StaticResource MetadataText}" />
                            <TextBlock Text="{Binding MetaLine}"
                                       Style="{StaticResource MetadataText}"
                                       TextWrapping="Wrap" />
                          </StackPanel>
                        </Border>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button x:Name="TopicsLoadMoreButton"
                        HorizontalAlignment="Center"
                        Visibility="Collapsed"
                        Click="TopicsLoadMoreButton_Click" />
              </StackPanel>
            </PivotItem>

            <PivotItem x:Name="RelatedTab">
              <StackPanel Spacing="12">
                <TextBlock x:Name="RelatedStatusText"
                           Style="{StaticResource MetadataText}"
                           TextWrapping="Wrap" />

                <TextBlock x:Name="RecommendationsTitle"
                           Style="{StaticResource SectionTitleText}" />
                <ItemsControl x:Name="RecommendationsList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              Padding="0"
                              Margin="0,0,0,8"
                              Tag="{Binding Subject}"
                              Click="RelatedSubject_Click">
                        <Border Padding="10"
                                CornerRadius="8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                          <Grid ColumnDefinitions="52,*"
                                ColumnSpacing="10">
                            <Border Width="48"
                                    Height="68"
                                    CornerRadius="6"
                                    Background="{ThemeResource EizoSelectionBrush}">
                              <Image Source="{Binding Artwork}"
                                     Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="3">
                              <TextBlock Text="{Binding Title}"
                                         FontWeight="SemiBold"
                                         TextWrapping="Wrap" />
                              <TextBlock Text="{Binding Subtitle}"
                                         Style="{StaticResource MetadataText}"
                                         TextTrimming="CharacterEllipsis" />
                              <TextBlock Text="{Binding MetaLine}"
                                         Style="{StaticResource MetadataText}"
                                         TextWrapping="Wrap" />
                            </StackPanel>
                          </Grid>
                        </Border>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="RelationsTitle"
                           Margin="0,6,0,0"
                           Style="{StaticResource SectionTitleText}" />
                <ItemsControl x:Name="RelationsList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              Padding="0"
                              Margin="0,0,0,8"
                              Tag="{Binding Subject}"
                              Click="RelatedSubject_Click">
                        <Border Padding="10"
                                CornerRadius="8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                          <Grid ColumnDefinitions="52,*"
                                ColumnSpacing="10">
                            <Border Width="48"
                                    Height="68"
                                    CornerRadius="6"
                                    Background="{ThemeResource EizoSelectionBrush}">
                              <Image Source="{Binding Artwork}"
                                     Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="3">
                              <TextBlock Text="{Binding Title}"
                                         FontWeight="SemiBold"
                                         TextWrapping="Wrap" />
                              <TextBlock Text="{Binding Subtitle}"
                                         Style="{StaticResource MetadataText}"
                                         TextTrimming="CharacterEllipsis" />
                              <TextBlock Text="{Binding MetaLine}"
                                         Style="{StaticResource MetadataText}"
                                         TextWrapping="Wrap" />
                            </StackPanel>
                          </Grid>
                        </Border>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </PivotItem>
          </Pivot>
        </StackPanel>
      </Grid>
    </Grid>
  </ScrollViewer>
</UserControl>
