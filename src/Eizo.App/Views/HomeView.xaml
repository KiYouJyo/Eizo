<UserControl x:Class="Eizo.Views.HomeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="using:Eizo.Models">
 <ScrollViewer><Grid MaxWidth="1200" Margin="32" HorizontalAlignment="Stretch" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="18">
  <Grid ColumnDefinitions="*,380"><StackPanel Spacing="4"><TextBlock x:Name="PageTitle" Style="{StaticResource PageTitleText}"/><TextBlock x:Name="PageSubtitle" Style="{StaticResource MetadataText}"/></StackPanel><AutoSuggestBox x:Name="SearchBox" Grid.Column="1" Height="38" VerticalAlignment="Top" QueryIcon="Find"/></Grid>
  <Button x:Name="FeaturedButton" Grid.Row="1" Style="{StaticResource HeroCardButton}" Click="FeaturedButton_Click"><Grid ColumnDefinitions="1.05*,0.95*">
   <StackPanel Padding="26" Spacing="10" VerticalAlignment="Center"><TextBlock x:Name="FeaturedEyebrow" Style="{StaticResource MetadataText}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/><TextBlock Text="葬送的芙莉莲" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="葬送のフリーレン" Style="{StaticResource BodyText}"/><TextBlock Text="TV · 2023 · MADHOUSE · 28" Style="{StaticResource MetadataText}"/><TextBlock x:Name="FeaturedDescription" MaxWidth="520" TextWrapping="Wrap" Style="{StaticResource BodyText}"/><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="FeaturedPlayButton" Style="{StaticResource CompactActionButton}" Click="FeaturedPlayButton_Click"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE768;" FontSize="12"/><TextBlock x:Name="FeaturedPlayText"/></StackPanel></Button><Button x:Name="FeaturedDetailsButton" Style="{StaticResource CompactActionButton}" Click="FeaturedButton_Click"/></StackPanel></StackPanel>
   <Border Grid.Column="1" Margin="12" CornerRadius="8" Background="{ThemeResource EizoSelectionBrush}"><FontIcon Glyph="&#xE8B9;" FontSize="72" Opacity="0.22"/></Border>
  </Grid></Button>
  <Grid Grid.Row="2" ColumnDefinitions="*,Auto"><TextBlock x:Name="ContinueTitle" Style="{StaticResource SectionTitleText}"/><Button x:Name="ContinueAllButton" Grid.Column="1" Style="{StaticResource CompactActionButton}"/></Grid>
  <ItemsRepeater x:Name="ContinueRepeater" Grid.Row="3"><ItemsRepeater.Layout><UniformGridLayout MinItemWidth="245" MinItemHeight="156" MinColumnSpacing="12" MinRowSpacing="12" ItemsStretch="Fill"/></ItemsRepeater.Layout><ItemsRepeater.ItemTemplate><DataTemplate x:DataType="models:MediaCardModel"><Button Style="{StaticResource MediaCardButton}" Tag="{x:Bind Title}" Click="MediaCard_Click"><Grid RowDefinitions="86,*"><Border Background="{ThemeResource EizoSelectionBrush}" CornerRadius="8,8,0,0"><FontIcon Glyph="&#xE8B9;" FontSize="30" Opacity="0.28"/></Border><Grid Grid.Row="1" Padding="12,8" RowDefinitions="Auto,Auto,*"><TextBlock Text="{x:Bind Title}" Style="{StaticResource CardTitleText}"/><TextBlock Grid.Row="1" Text="{x:Bind NativeTitle}" Style="{StaticResource MetadataText}"/><ProgressBar Grid.Row="2" Value="{x:Bind Progress}" Maximum="100" Height="3" Margin="0,8,0,0" VerticalAlignment="Bottom"/></Grid></Grid></Button></DataTemplate></ItemsRepeater.ItemTemplate></ItemsRepeater>
  <Grid Grid.Row="4" ColumnDefinitions="*,Auto"><TextBlock x:Name="SeasonTitle" Style="{StaticResource SectionTitleText}"/><Button x:Name="SeasonAllButton" Grid.Column="1" Style="{StaticResource CompactActionButton}"/></Grid>
  <ItemsRepeater x:Name="SeasonRepeater" Grid.Row="5"><ItemsRepeater.Layout><UniformGridLayout MinItemWidth="205" MinItemHeight="182" MinColumnSpacing="12" MinRowSpacing="12" ItemsStretch="Fill"/></ItemsRepeater.Layout><ItemsRepeater.ItemTemplate><DataTemplate x:DataType="models:MediaCardModel"><Button Style="{StaticResource MediaCardButton}" Height="182" Tag="{x:Bind Title}" Click="MediaCard_Click"><Grid RowDefinitions="108,*"><Border Background="{ThemeResource EizoSelectionBrush}" CornerRadius="8,8,0,0"><FontIcon Glyph="&#xE8B9;" FontSize="34" Opacity="0.25"/></Border><StackPanel Grid.Row="1" Padding="12,8" Spacing="2"><TextBlock Text="{x:Bind Title}" Style="{StaticResource CardTitleText}"/><TextBlock Text="{x:Bind NativeTitle}" Style="{StaticResource MetadataText}"/><TextBlock Text="{x:Bind Meta}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontSize="10"/></StackPanel></Grid></Button></DataTemplate></ItemsRepeater.ItemTemplate></ItemsRepeater>
 </Grid></ScrollViewer>
</UserControl>
