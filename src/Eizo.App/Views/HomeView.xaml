<UserControl x:Class="Eizo.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:Eizo.Models">
  <UserControl.Resources>
    <DataTemplate x:Key="ContinueCardTemplate" x:DataType="models:HomeContinueCardModel">
      <Button Style="{StaticResource MediaCardButton}"
              Tag="{x:Bind MediaItem}"
              Click="MediaCard_Click">
        <Grid RowDefinitions="86,*">
          <Border Background="{ThemeResource EizoSelectionBrush}"
                  CornerRadius="8,8,0,0">
            <Grid>
              <FontIcon Glyph="&#xE8B9;"
                        FontSize="30"
                        Opacity="0.18" />
              <Image Source="{Binding ArtworkUrl}"
                     Stretch="UniformToFill" />
            </Grid>
          </Border>
          <Grid Grid.Row="1"
                Padding="12,8"
                RowDefinitions="Auto,Auto,*">
            <TextBlock Text="{x:Bind Title}"
                       Style="{StaticResource CardTitleText}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Row="1"
                       Text="{x:Bind Meta}"
                       Style="{StaticResource MetadataText}"
                       TextTrimming="CharacterEllipsis" />
            <ProgressBar Grid.Row="2"
                         Value="{x:Bind Progress}"
                         Maximum="100"
                         Height="3"
                         Margin="0,8,0,0"
                         VerticalAlignment="Bottom" />
          </Grid>
        </Grid>
      </Button>
    </DataTemplate>

    <DataTemplate x:Key="SeasonCardTemplate" x:DataType="models:MediaCardModel">
      <Button Style="{StaticResource MediaCardButton}"
              Height="182"
              Tag="{x:Bind ExternalKey}"
              Click="SeasonCard_Click">
        <Grid RowDefinitions="108,*">
          <Border Background="{ThemeResource EizoSelectionBrush}"
                  CornerRadius="8,8,0,0">
            <FontIcon Glyph="&#xE8B9;"
                      FontSize="34"
                      Opacity="0.25" />
          </Border>
          <StackPanel Grid.Row="1"
                      Padding="12,8"
                      Spacing="2">
            <TextBlock Text="{x:Bind Title}"
                       Style="{StaticResource CardTitleText}" />
            <TextBlock Text="{x:Bind NativeTitle}"
                       Style="{StaticResource MetadataText}" />
            <TextBlock Text="{x:Bind Meta}"
                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                       FontSize="10" />
          </StackPanel>
        </Grid>
      </Button>
    </DataTemplate>
  </UserControl.Resources>

  <ScrollViewer Background="Transparent"
                HorizontalScrollMode="Disabled"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalContentAlignment="Stretch">
    <Grid x:Name="HomeRoot"
          Padding="24,16,24,32"
          HorizontalAlignment="Stretch"
          RowDefinitions="Auto,18,Auto,18,Auto,18,Auto,12,Auto,18,Auto,12,Auto"
          UseLayoutRounding="True">
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup>
          <VisualState x:Name="HomeCompact">
            <VisualState.StateTriggers>
              <AdaptiveTrigger MinWindowWidth="0" />
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter Target="HeroText.(Grid.ColumnSpan)" Value="2" />
              <Setter Target="HeroArtwork.Visibility" Value="Collapsed" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="HomeWide">
            <VisualState.StateTriggers>
              <AdaptiveTrigger MinWindowWidth="900" />
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter Target="HeroText.(Grid.ColumnSpan)" Value="1" />
              <Setter Target="HeroArtwork.Visibility" Value="Visible" />
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>

      <TextBlock x:Name="PageTitle"
                 Style="{StaticResource PageTitleText}" />

      <AutoSuggestBox x:Name="SearchBox"
                      Grid.Row="2"
                      Height="38"
                      QueryIcon="Find"
                      HorizontalAlignment="Stretch"
                      TextChanged="SearchBox_TextChanged"
                      SuggestionChosen="SearchBox_SuggestionChosen"
                      QuerySubmitted="SearchBox_QuerySubmitted" />

      <Border Grid.Row="4"
              MinHeight="250"
              CornerRadius="10"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1">
        <Grid ColumnDefinitions="1.05*,0.95*">
          <StackPanel x:Name="HeroText"
                      Grid.ColumnSpan="2"
                      Padding="26"
                      Spacing="10"
                      VerticalAlignment="Center">
            <TextBlock x:Name="FeaturedEyebrow"
                       Style="{StaticResource MetadataText}"
                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <TextBlock x:Name="FeaturedTitle"
                       FontSize="28"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="FeaturedNativeTitle"
                       Style="{StaticResource BodyText}" />
            <TextBlock x:Name="FeaturedMeta"
                       Style="{StaticResource MetadataText}" />
            <TextBlock x:Name="FeaturedDescription"
                       MaxWidth="560"
                       TextWrapping="Wrap"
                       Style="{StaticResource BodyText}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button x:Name="FeaturedPlayButton"
                      Style="{StaticResource CompactActionButton}"
                      Click="FeaturedPlayButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <FontIcon Glyph="&#xE768;" FontSize="12" />
                  <TextBlock x:Name="FeaturedPlayText" />
                </StackPanel>
              </Button>
              <Button x:Name="FeaturedDetailsButton"
                      Style="{StaticResource CompactActionButton}"
                      Click="FeaturedButton_Click" />
            </StackPanel>
          </StackPanel>

          <Border x:Name="HeroArtwork"
                  Grid.Column="1"
                  Margin="12"
                  Visibility="Collapsed"
                  CornerRadius="8"
                  Background="{ThemeResource EizoSelectionBrush}">
            <Grid>
              <FontIcon Glyph="&#xE8B9;"
                        FontSize="72"
                        Opacity="0.18" />
              <Image x:Name="HeroArtworkImage"
                     Stretch="UniformToFill" />
              <Rectangle VerticalAlignment="Stretch">
                <Rectangle.Fill>
                  <LinearGradientBrush StartPoint="0,0.5"
                                       EndPoint="1,0.5">
                    <GradientStop Offset="0"
                                  Color="#AA202525" />
                    <GradientStop Offset="0.45"
                                  Color="#44202525" />
                    <GradientStop Offset="1"
                                  Color="#00202525" />
                  </LinearGradientBrush>
                </Rectangle.Fill>
              </Rectangle>
            </Grid>
          </Border>
        </Grid>
      </Border>

      <Grid Grid.Row="6"
            ColumnDefinitions="*,Auto">
        <TextBlock x:Name="ContinueTitle"
                   Style="{StaticResource SectionTitleText}" />
        <Button x:Name="ContinueAllButton"
                Grid.Column="1"
                Style="{StaticResource CompactActionButton}"
                Click="ContinueAllButton_Click" />
      </Grid>

      <!-- Deliberately mirrors SpatialViewer's explicit responsive grids.
           Do not replace with ItemsRepeater + UniformGridLayout: WinUI can fail-fast
           when the available width becomes narrower than one item stride. -->
      <Grid x:Name="ContinueGrid"
            Grid.Row="8"
            ColumnSpacing="12"
            RowSpacing="12" />

      <Grid Grid.Row="10"
            ColumnDefinitions="*,Auto,Auto"
            ColumnSpacing="8">
        <StackPanel Spacing="2">
          <TextBlock x:Name="SeasonTitle"
                     Style="{StaticResource SectionTitleText}" />
          <TextBlock x:Name="SeasonStatusText"
                     Style="{StaticResource MetadataText}"
                     TextWrapping="Wrap" />
        </StackPanel>
        <ProgressRing x:Name="SeasonLoadingRing"
                      Grid.Column="1"
                      Width="18"
                      Height="18"
                      IsActive="False"
                      Visibility="Collapsed"
                      VerticalAlignment="Center" />
        <Button x:Name="SeasonAllButton"
                Grid.Column="2"
                Style="{StaticResource CompactActionButton}"
                Click="SeasonAllButton_Click" />
      </Grid>

      <Grid x:Name="SeasonGrid"
            Grid.Row="12"
            ColumnSpacing="12"
            RowSpacing="12" />
    </Grid>
  </ScrollViewer>
</UserControl>
