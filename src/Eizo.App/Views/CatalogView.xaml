<UserControl x:Class="Eizo.Views.CatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <CollectionViewSource x:Key="GroupedCatalogItems"
                          IsSourceGrouped="True" />
  </UserControl.Resources>

  <Grid Padding="24,16,24,32"
        RowDefinitions="Auto,Auto,Auto,Auto,*"
        HorizontalAlignment="Stretch"
        UseLayoutRounding="True">
    <TextBlock x:Name="PageTitle"
               Style="{StaticResource PageTitleText}" />

    <TextBlock x:Name="PageSubtitle"
               Grid.Row="1"
               Margin="0,6,0,0"
               Style="{StaticResource BodyText}"
               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
               TextWrapping="Wrap" />

    <Grid Grid.Row="2"
          Margin="0,14,0,0"
          ColumnDefinitions="*,Auto,Auto"
          ColumnSpacing="8">
      <AutoSuggestBox x:Name="SearchBox"
                      Height="38"
                      QueryIcon="Find"
                      TextChanged="SearchBox_TextChanged"
                      HorizontalAlignment="Stretch" />
      <Button x:Name="ClearSearchButton"
              Grid.Column="1"
              Height="38"
              MinWidth="72"
              Click="ClearSearchButton_Click" />
      <Button x:Name="ExportRecognitionButton"
              Grid.Column="2"
              Height="38"
              MinWidth="120"
              Click="ExportRecognitionButton_Click" />
    </Grid>

    <TextBlock x:Name="RecognitionSummary"
               Grid.Row="3"
               Margin="0,10,0,0"
               Style="{StaticResource MetadataText}"
               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
               TextWrapping="Wrap" />

    <TextBlock x:Name="EmptyStateText"
               Grid.Row="4"
               Margin="0,20,0,0"
               FontSize="14"
               Opacity="0.68"
               TextWrapping="Wrap"
               Visibility="Collapsed" />

    <ListView x:Name="ResultsList"
              Grid.Row="4"
              Margin="0,10,0,0"
              ItemsSource="{Binding Source={StaticResource GroupedCatalogItems}}"
              SelectionMode="None"
              IsItemClickEnabled="True"
              ItemClick="ResultsList_ItemClick"
              ContainerContentChanging="ResultsList_ContainerContentChanging"
              ScrollViewer.HorizontalScrollMode="Disabled"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListView.GroupStyle>
        <GroupStyle>
          <GroupStyle.HeaderTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Key}"
                         Margin="0,12,0,6"
                         FontSize="18"
                         FontWeight="SemiBold" />
            </DataTemplate>
          </GroupStyle.HeaderTemplate>
        </GroupStyle>
      </ListView.GroupStyle>

      <ListView.ItemContainerStyle>
        <Style TargetType="ListViewItem">
          <Setter Property="MinHeight" Value="68" />
          <Setter Property="Padding" Value="14,8" />
          <Setter Property="Margin" Value="0,0,0,8" />
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
          <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
          <Setter Property="BorderThickness" Value="1" />
          <Setter Property="CornerRadius" Value="8" />
        </Style>
      </ListView.ItemContainerStyle>

      <ListView.ItemTemplate>
        <DataTemplate>
          <Grid ColumnDefinitions="34,*,Auto"
                ColumnSpacing="12">
            <FontIcon Glyph="{Binding IconGlyph}"
                      FontSize="18"
                      VerticalAlignment="Center" />

            <StackPanel Grid.Column="1"
                        Spacing="2"
                        VerticalAlignment="Center">
              <TextBlock Text="{Binding Title}"
                         FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Secondary}"
                         Opacity="0.68"
                         FontSize="12"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <TextBlock Grid.Column="2"
                       Text="{Binding TypeLabel}"
                       VerticalAlignment="Center"
                       Opacity="0.68"
                       FontSize="12" />
          </Grid>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>
  </Grid>
</UserControl>
