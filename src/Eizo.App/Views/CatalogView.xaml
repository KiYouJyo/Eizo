<UserControl x:Class="Eizo.Views.CatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <CollectionViewSource x:Key="GroupedCatalogItems"
                          IsSourceGrouped="True" />
  </UserControl.Resources>

  <Grid Padding="24,16,24,32"
        RowDefinitions="Auto,Auto,Auto,Auto,*"
        HorizontalAlignment="Stretch"
        UseLayoutRounding="True">
    <TextBlock x:Name="PageTitle"
               Style="{StaticResource PageTitleText}" />

    <TextBlock x:Name="PageSubtitle"
               Grid.Row="1"
               Margin="0,6,0,0"
               Style="{StaticResource BodyText}"
               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
               TextWrapping="Wrap" />

    <Grid Grid.Row="2"
          Margin="0,14,0,0"
          ColumnDefinitions="*,Auto,Auto"
          ColumnSpacing="8">
      <AutoSuggestBox x:Name="SearchBox"
                      Height="38"
                      QueryIcon="Find"
                      TextChanged="SearchBox_TextChanged"
                      HorizontalAlignment="Stretch" />
      <Button x:Name="ClearSearchButton"
              Grid.Column="1"
              Height="38"
              MinWidth="72"
              Click="ClearSearchButton_Click" />
      <Button x:Name="ExportRecognitionButton"
              Grid.Column="2"
              Height="38"
              MinWidth="120"
              Click="ExportRecognitionButton_Click" />
    </Grid>

    <TextBlock x:Name="RecognitionSummary"
               Grid.Row="3"
               Margin="0,10,0,0"
               Style="{StaticResource MetadataText}"
               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
               TextWrapping="Wrap" />

    <TextBlock x:Name="EmptyStateText"
               Grid.Row="4"
               Margin="0,20,0,0"
               FontSize="14"
               Opacity="0.68"
               TextWrapping="Wrap"
               Visibility="Collapsed" />

    <GridView x:Name="ResultsList"
              Grid.Row="4"
              Margin="0,10,0,0"
              ItemsSource="{Binding Source={StaticResource GroupedCatalogItems}}"
              SelectionMode="None"
              IsItemClickEnabled="True"
              ItemClick="ResultsList_ItemClick"
              ContainerContentChanging="ResultsList_ContainerContentChanging"
              ScrollViewer.HorizontalScrollMode="Disabled"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <GridView.ItemsPanel>
        <ItemsPanelTemplate>
          <ItemsWrapGrid Orientation="Horizontal"
                         ItemWidth="188"
                         ItemHeight="318" />
        </ItemsPanelTemplate>
      </GridView.ItemsPanel>

      <GridView.GroupStyle>
        <GroupStyle>
          <GroupStyle.HeaderTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Key}"
                         Margin="0,14,0,8"
                         FontSize="18"
                         FontWeight="SemiBold" />
            </DataTemplate>
          </GroupStyle.HeaderTemplate>
        </GroupStyle>
      </GridView.GroupStyle>

      <GridView.ItemContainerStyle>
        <Style TargetType="GridViewItem">
          <Setter Property="Width" Value="188" />
          <Setter Property="Height" Value="318" />
          <Setter Property="Padding" Value="0" />
          <Setter Property="Margin" Value="0,0,12,14" />
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
      </GridView.ItemContainerStyle>

      <GridView.ItemTemplate>
        <DataTemplate>
          <Border Width="180"
                  Height="306"
                  Margin="4,4,4,8"
                  CornerRadius="10"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1">
            <Grid RowDefinitions="220,*">
              <Border CornerRadius="9,9,0,0"
                      Background="{ThemeResource EizoSelectionBrush}">
                <Grid>
                  <FontIcon Glyph="{Binding IconGlyph}"
                            FontSize="48"
                            Opacity="0.18"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                  <Image Source="{Binding Artwork}"
                         Stretch="UniformToFill" />
                  <Border HorizontalAlignment="Right"
                          VerticalAlignment="Top"
                          Margin="8"
                          Padding="7,3"
                          CornerRadius="10"
                          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <TextBlock Text="{Binding TypeLabel}"
                               FontSize="11"
                               FontWeight="SemiBold" />
                  </Border>
                </Grid>
              </Border>

              <StackPanel Grid.Row="1"
                          Padding="10,8,10,10"
                          Spacing="3">
                <TextBlock Text="{Binding Title}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           MaxLines="2"
                           TextWrapping="WrapWholeWords"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Subtitle}"
                           FontSize="11"
                           Opacity="0.62"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding MetaLine}"
                           FontSize="11"
                           Opacity="0.78"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding SourceLabel}"
                           FontSize="10.5"
                           Opacity="0.58"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </GridView.ItemTemplate>
    </GridView>
  </Grid>
</UserControl>
