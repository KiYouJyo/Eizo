<UserControl x:Class="Eizo.Views.CatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style x:Key="CatalogRowButtonStyle"
           TargetType="Button">
      <Setter Property="MinHeight" Value="68" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Background"
              Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
      <Setter Property="BorderBrush"
              Value="{ThemeResource CardStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
  </UserControl.Resources>

  <ScrollViewer Background="Transparent"
                HorizontalScrollMode="Disabled"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalContentAlignment="Stretch">
    <Grid Padding="24,16,24,32"
          RowDefinitions="Auto,Auto,Auto,Auto"
          HorizontalAlignment="Stretch"
          UseLayoutRounding="True">
      <TextBlock x:Name="PageTitle"
                 Style="{StaticResource PageTitleText}" />

      <TextBlock x:Name="PageSubtitle"
                 Grid.Row="1"
                 Margin="0,6,0,0"
                 Style="{StaticResource BodyText}"
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                 TextWrapping="Wrap" />

      <Grid Grid.Row="2"
            Margin="0,14,0,0"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="8">
        <AutoSuggestBox x:Name="SearchBox"
                        Height="38"
                        QueryIcon="Find"
                        TextChanged="SearchBox_TextChanged"
                        HorizontalAlignment="Stretch" />
        <Button x:Name="ClearSearchButton"
                Grid.Column="1"
                Height="38"
                MinWidth="72"
                Click="ClearSearchButton_Click" />
      </Grid>

      <StackPanel x:Name="ResultsPanel"
                  Grid.Row="3"
                  Margin="0,14,0,0"
                  Spacing="8"
                  HorizontalAlignment="Stretch" />
    </Grid>
  </ScrollViewer>
</UserControl>
