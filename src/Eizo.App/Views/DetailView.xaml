<UserControl x:Class="Eizo.Views.DetailView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="using:Eizo.Models">
 <ScrollViewer><StackPanel Margin="28" Spacing="16">
  <Border Height="300" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"><Grid ColumnDefinitions="220,*" Padding="22"><Border CornerRadius="8" Background="{ThemeResource EizoSelectionBrush}"><FontIcon Glyph="&#xE8B9;" FontSize="64" Opacity="0.22"/></Border><StackPanel Grid.Column="1" Padding="26,8" Spacing="10" VerticalAlignment="Center"><TextBlock x:Name="TitleText" FontSize="30" FontWeight="SemiBold"/><TextBlock x:Name="NativeTitleText" FontSize="16"/><TextBlock Text="TV · 2023 · 28 · MADHOUSE" Style="{StaticResource MetadataText}"/><TextBlock x:Name="OverviewText" MaxWidth="760" TextWrapping="Wrap" Style="{StaticResource BodyText}"/><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="PlayButton" Style="{StaticResource CompactActionButton}" Click="PlayButton_Click"/><Button x:Name="FavoriteButton" Style="{StaticResource CompactActionButton}"/></StackPanel></StackPanel></Grid></Border>
  <Grid MinHeight="500" ColumnDefinitions="1.8*,1*" ColumnSpacing="16">
   <Border Style="{StaticResource SectionCardStyle}"><Grid RowDefinitions="Auto,*" RowSpacing="12"><Grid ColumnDefinitions="*,Auto"><StackPanel Orientation="Horizontal" Spacing="10"><TextBlock x:Name="EpisodesTitle" Style="{StaticResource SectionTitleText}"/><TextBlock Text="1 · 28" Style="{StaticResource MetadataText}" VerticalAlignment="Center"/></StackPanel><ComboBox Grid.Column="1" Width="140" SelectedIndex="0"><ComboBoxItem Content="Season 1"/></ComboBox></Grid><ListView x:Name="EpisodeList" Grid.Row="1" SelectionMode="None" ItemContainerStyle="{StaticResource SourceListItemStyle}"><ListView.ItemTemplate><DataTemplate x:DataType="models:EpisodeItemModel"><Grid Height="82" ColumnDefinitions="110,48,*,100" ColumnSpacing="10"><Border CornerRadius="6" Background="{ThemeResource EizoSelectionBrush}"><FontIcon Glyph="&#xE8B9;" FontSize="24" Opacity="0.25"/></Border><TextBlock Grid.Column="1" Text="{x:Bind Number}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3"><TextBlock Text="{x:Bind Title}" Style="{StaticResource CardTitleText}"/><TextBlock Text="{x:Bind NativeTitle}" Style="{StaticResource MetadataText}"/><ProgressBar Value="{x:Bind Progress}" Maximum="100" Height="3"/></StackPanel><StackPanel Grid.Column="3" VerticalAlignment="Center"><TextBlock Text="{x:Bind Duration}" Style="{StaticResource MetadataText}" HorizontalAlignment="Right"/><TextBlock Text="{x:Bind Status}" Style="{StaticResource MetadataText}" HorizontalAlignment="Right"/></StackPanel></Grid></DataTemplate></ListView.ItemTemplate></ListView></Grid></Border>
   <Border Grid.Column="1" Style="{StaticResource SectionCardStyle}"><StackPanel Spacing="14"><TextBlock x:Name="CastTitle" Style="{StaticResource SectionTitleText}"/><Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10"><Border Style="{StaticResource InnerCardStyle}"><StackPanel Padding="12" Spacing="3"><TextBlock Text="芙莉莲" Style="{StaticResource CardTitleText}"/><TextBlock Text="フリーレン" Style="{StaticResource MetadataText}"/><TextBlock Text="种崎敦美" Style="{StaticResource MetadataText}"/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource InnerCardStyle}"><StackPanel Padding="12" Spacing="3"><TextBlock Text="菲伦" Style="{StaticResource CardTitleText}"/><TextBlock Text="フェルン" Style="{StaticResource MetadataText}"/><TextBlock Text="市之濑加那" Style="{StaticResource MetadataText}"/></StackPanel></Border><Border Grid.Row="1" Style="{StaticResource InnerCardStyle}"><StackPanel Padding="12" Spacing="3"><TextBlock Text="修塔尔克" Style="{StaticResource CardTitleText}"/><TextBlock Text="シュタルク" Style="{StaticResource MetadataText}"/><TextBlock Text="小林千晃" Style="{StaticResource MetadataText}"/></StackPanel></Border><Border Grid.Row="1" Grid.Column="1" Style="{StaticResource InnerCardStyle}"><StackPanel Padding="12" Spacing="3"><TextBlock Text="欣梅尔" Style="{StaticResource CardTitleText}"/><TextBlock Text="ヒンメル" Style="{StaticResource MetadataText}"/><TextBlock Text="冈本信彦" Style="{StaticResource MetadataText}"/></StackPanel></Border></Grid><TextBlock x:Name="StaffTitle" Style="{StaticResource SectionTitleText}" Margin="0,8,0,0"/><Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10"><TextBlock x:Name="OriginalLabel" Style="{StaticResource MetadataText}"/><TextBlock Grid.Column="1" Text="山田钟人 / 阿部司" Style="{StaticResource BodyText}"/><TextBlock Grid.Row="1" x:Name="DirectorLabel" Style="{StaticResource MetadataText}"/><TextBlock Grid.Row="1" Grid.Column="1" Text="斋藤圭一郎" Style="{StaticResource BodyText}"/><TextBlock Grid.Row="2" x:Name="StudioLabel" Style="{StaticResource MetadataText}"/><TextBlock Grid.Row="2" Grid.Column="1" Text="MADHOUSE" Style="{StaticResource BodyText}"/><TextBlock Grid.Row="3" x:Name="SeriesCompositionLabel" Style="{StaticResource MetadataText}"/><TextBlock Grid.Row="3" Grid.Column="1" Text="铃木智寻" Style="{StaticResource BodyText}"/></Grid></StackPanel></Border>
  </Grid>
 </StackPanel></ScrollViewer>
</UserControl>
