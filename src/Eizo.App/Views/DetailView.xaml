<UserControl x:Class="Eizo.Views.DetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:Eizo.Models"
             xmlns:controls="using:Eizo.Controls">
  <ScrollViewer>
    <StackPanel Margin="28"
                Spacing="16">
      <Border Height="300"
              CornerRadius="10"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1">
        <Grid ColumnDefinitions="220,*"
              Padding="22">
          <Border CornerRadius="8"
                  Background="{ThemeResource EizoSelectionBrush}">
            <Grid>
              <Image x:Name="PosterImage"
                     Stretch="UniformToFill" />
              <FontIcon x:Name="PosterPlaceholder"
                        Glyph="&#xE8B9;"
                        FontSize="64"
                        Opacity="0.22"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
            </Grid>
          </Border>

          <StackPanel Grid.Column="1"
                      Padding="26,8"
                      Spacing="10"
                      VerticalAlignment="Center">
            <TextBlock x:Name="TitleText"
                       FontSize="30"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="NativeTitleText"
                       FontSize="16"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="MetaText"
                       Style="{StaticResource MetadataText}"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="OverviewText"
                       MaxWidth="760"
                       MaxHeight="110"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"
                       Style="{StaticResource BodyText}" />
            <StackPanel Orientation="Horizontal"
                        Spacing="8">
              <Button x:Name="PlayButton"
                      Style="{StaticResource CompactActionButton}"
                      Click="PlayButton_Click" />
              <Button x:Name="FavoriteButton"
                      Style="{StaticResource CompactActionButton}" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>

      <Grid MinHeight="500"
            ColumnDefinitions="1.8*,1*"
            ColumnSpacing="16">
        <Border Style="{StaticResource SectionCardStyle}">
          <Grid RowDefinitions="Auto,*"
                RowSpacing="12">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Orientation="Horizontal"
                          Spacing="10">
                <TextBlock x:Name="EpisodesTitle"
                           Style="{StaticResource SectionTitleText}" />
                <TextBlock x:Name="EpisodeCountText"
                           Style="{StaticResource MetadataText}"
                           VerticalAlignment="Center" />
              </StackPanel>

              <ComboBox x:Name="SeasonComboBox"
                        Grid.Column="1"
                        Width="150"
                        controls:TransientComboBoxTheme.Apply="True"
                        DisplayMemberPath="Label"
                        SelectionChanged="SeasonComboBox_SelectionChanged" />
            </Grid>

            <ListView x:Name="EpisodeList"
                      Grid.Row="1"
                      SelectionMode="None"
                      IsItemClickEnabled="True"
                      ItemClick="EpisodeList_ItemClick"
                      ItemContainerStyle="{StaticResource SourceListItemStyle}">
              <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:EpisodeItemModel">
                  <Grid Height="82"
                        ColumnDefinitions="86,48,*,100"
                        ColumnSpacing="10">
                    <Border CornerRadius="6"
                            Background="{ThemeResource EizoSelectionBrush}">
                      <FontIcon Glyph="&#xE8B9;"
                                FontSize="24"
                                Opacity="0.25" />
                    </Border>
                    <TextBlock Grid.Column="1"
                               Text="{x:Bind Number}"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center"
                                Spacing="3">
                      <TextBlock Text="{x:Bind Title}"
                                 Style="{StaticResource CardTitleText}"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{x:Bind NativeTitle}"
                                 Style="{StaticResource MetadataText}"
                                 TextTrimming="CharacterEllipsis" />
                      <ProgressBar Value="{x:Bind Progress}"
                                   Maximum="100"
                                   Height="3" />
                    </StackPanel>
                    <StackPanel Grid.Column="3"
                                VerticalAlignment="Center">
                      <TextBlock Text="{x:Bind Duration}"
                                 Style="{StaticResource MetadataText}"
                                 HorizontalAlignment="Right" />
                      <TextBlock Text="{x:Bind Status}"
                                 Style="{StaticResource MetadataText}"
                                 HorizontalAlignment="Right" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
          </Grid>
        </Border>

        <Border Grid.Column="1"
                Style="{StaticResource SectionCardStyle}">
          <StackPanel Spacing="14">
            <TextBlock x:Name="InfoTitle"
                       Style="{StaticResource SectionTitleText}" />
            <TextBlock x:Name="InfoText"
                       Style="{StaticResource BodyText}"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="ExternalIdsTitle"
                       Style="{StaticResource SectionTitleText}"
                       Margin="0,8,0,0" />
            <TextBlock x:Name="ExternalIdsText"
                       Style="{StaticResource MetadataText}"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
