<UserControl x:Class="Eizo.Views.DetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:Eizo.Models"
             xmlns:controls="using:Eizo.Controls">
  <ScrollViewer>
    <StackPanel Margin="28"
                Spacing="18">
      <Border Height="278"
              MaxHeight="278"
              CornerRadius="12"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1">
        <Grid x:Name="HeroLayout"
              ColumnDefinitions="1.05*,0.95*"
              SizeChanged="HeroLayout_SizeChanged">

          <Grid x:Name="HeroContent"
                Grid.ColumnSpan="1"
                Padding="22"
                ColumnDefinitions="126,*"
                ColumnSpacing="18">
            <Border Width="118"
                    Height="176"
                    CornerRadius="8"
                    Background="{ThemeResource EizoSelectionBrush}"
                    VerticalAlignment="Center">
              <Grid>
                <FontIcon x:Name="PosterPlaceholder"
                          Glyph="&#xE8B9;"
                          FontSize="40"
                          Opacity="0.22"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                <Image x:Name="PosterImage"
                       Stretch="UniformToFill" />
              </Grid>
            </Border>

            <StackPanel Grid.Column="1"
                        Spacing="7"
                        VerticalAlignment="Center">
              <TextBlock x:Name="TitleText"
                         FontSize="28"
                         FontWeight="SemiBold"
                         TextWrapping="Wrap"
                         MaxLines="2"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock x:Name="NativeTitleText"
                         FontSize="14"
                         Opacity="0.72"
                         TextWrapping="Wrap"
                         Visibility="Collapsed" />

              <StackPanel Orientation="Horizontal"
                          Spacing="8">
                <Border x:Name="ReleaseStatBadge"
                        Padding="9,4"
                        CornerRadius="12"
                        Background="{ThemeResource EizoSelectionBrush}">
                  <TextBlock x:Name="ReleaseStatText"
                             FontSize="12"
                             FontWeight="SemiBold" />
                </Border>
                <Border x:Name="EpisodeStatBadge"
                        Padding="9,4"
                        CornerRadius="12"
                        Background="{ThemeResource EizoSelectionBrush}">
                  <TextBlock x:Name="EpisodeStatText"
                             FontSize="12"
                             FontWeight="SemiBold" />
                </Border>
                <Border x:Name="SourceStatBadge"
                        Padding="9,4"
                        CornerRadius="12"
                        Background="{ThemeResource EizoSelectionBrush}">
                  <TextBlock x:Name="SourceStatText"
                             FontSize="12"
                             FontWeight="SemiBold" />
                </Border>
              </StackPanel>

              <TextBlock x:Name="MetaText"
                         Style="{StaticResource MetadataText}"
                         TextWrapping="Wrap"
                         MaxLines="1"
                         TextTrimming="CharacterEllipsis"
                         Visibility="Collapsed" />

              <TextBlock x:Name="OverviewText"
                         MaxHeight="60"
                         TextWrapping="Wrap"
                         MaxLines="3"
                         TextTrimming="CharacterEllipsis"
                         Style="{StaticResource BodyText}"
                         Visibility="Collapsed" />

              <StackPanel Orientation="Horizontal"
                          Spacing="8">
                <Button x:Name="PlayButton"
                        Style="{StaticResource CompactActionButton}"
                        Click="PlayButton_Click" />
                <Button x:Name="RescrapeButton"
                        Style="{StaticResource CompactActionButton}"
                        Click="RescrapeButton_Click" />
                <Button x:Name="ManualMatchButton"
                        Style="{StaticResource CompactActionButton}"
                        Click="ManualMatchButton_Click" />
                <Button x:Name="ClearManualMatchButton"
                        Style="{StaticResource CompactActionButton}"
                        Visibility="Collapsed"
                        Click="ClearManualMatchButton_Click" />
              </StackPanel>
            </StackPanel>
          </Grid>

          <Border x:Name="HeroArtwork"
                  Grid.Column="1"
                  Margin="12"
                  Visibility="Visible"
                  CornerRadius="9"
                  Background="{ThemeResource EizoSelectionBrush}">
            <Grid>
              <FontIcon Glyph="&#xE8B9;"
                        FontSize="72"
                        Opacity="0.18"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
              <Image x:Name="BackdropImage"
                     Stretch="UniformToFill" />
              <Rectangle>
                <Rectangle.Fill>
                  <LinearGradientBrush StartPoint="0,0.5"
                                       EndPoint="1,0.5">
                    <GradientStop Offset="0"
                                  Color="#88202525" />
                    <GradientStop Offset="0.35"
                                  Color="#30202525" />
                    <GradientStop Offset="1"
                                  Color="#00202525" />
                  </LinearGradientBrush>
                </Rectangle.Fill>
              </Rectangle>
            </Grid>
          </Border>
        </Grid>
      </Border>

      <InfoBar x:Name="MetadataActionStatusBar"
               IsOpen="False"
               IsClosable="True"
               Severity="Informational" />

      <Grid MinHeight="520"
            ColumnDefinitions="2.15*,1*"
            ColumnSpacing="16">
        <Border Style="{StaticResource SectionCardStyle}">
          <Grid RowDefinitions="Auto,*"
                RowSpacing="12">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Orientation="Horizontal"
                          Spacing="10">
                <TextBlock x:Name="EpisodesTitle"
                           Style="{StaticResource SectionTitleText}" />
                <TextBlock x:Name="EpisodeCountText"
                           Style="{StaticResource MetadataText}"
                           VerticalAlignment="Center" />
              </StackPanel>

              <ComboBox x:Name="SeasonComboBox"
                        Grid.Column="1"
                        MinWidth="150"
                        controls:TransientComboBoxTheme.Apply="True"
                        DisplayMemberPath="Label"
                        SelectionChanged="SeasonComboBox_SelectionChanged" />
            </Grid>

            <TextBlock x:Name="EpisodeEmptyStateText"
                       Grid.Row="1"
                       Margin="4,18,4,0"
                       Style="{StaticResource MetadataText}"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />

            <ListView x:Name="EpisodeList"
                      Grid.Row="1"
                      SelectionMode="None"
                      IsItemClickEnabled="True"
                      ItemClick="EpisodeList_ItemClick"
                      Padding="0,2,0,0">
              <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem"
                       BasedOn="{StaticResource SourceListItemStyle}">
                  <Setter Property="Margin"
                          Value="0,0,0,8" />
                </Style>
              </ListView.ItemContainerStyle>
              <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:EpisodeDisplayItemModel">
                  <Grid Height="100"
                        ColumnDefinitions="132,48,*,52"
                        ColumnSpacing="12">
                    <Border Width="132"
                            Height="74"
                            CornerRadius="7"
                            Background="{ThemeResource EizoSelectionBrush}"
                            VerticalAlignment="Center">
                      <Grid>
                        <FontIcon Glyph="&#xE8B9;"
                                  FontSize="24"
                                  Opacity="0.22"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        <Image Source="{x:Bind Thumbnail}"
                               Stretch="UniformToFill" />
                      </Grid>
                    </Border>

                    <TextBlock Grid.Column="1"
                               Text="{x:Bind Number}"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center" />

                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center"
                                Spacing="4">
                      <TextBlock Text="{x:Bind Title}"
                                 Style="{StaticResource CardTitleText}"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{x:Bind SecondaryText}"
                                 Style="{StaticResource MetadataText}"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{x:Bind PlaybackText}"
                                 Style="{StaticResource MetadataText}"
                                 TextTrimming="CharacterEllipsis" />
                      <ProgressBar Value="{x:Bind Progress}"
                                   Maximum="100"
                                   Height="3"
                                   Margin="0,2,0,0"
                                   Visibility="{x:Bind ProgressVisibility}" />
                    </StackPanel>

                    <Button Grid.Column="3"
                            Tag="{x:Bind Self}"
                            Click="CacheEpisodeButton_Click"
                            IsEnabled="{x:Bind CanCache}"
                            Width="38"
                            Height="38"
                            MinWidth="38"
                            Padding="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                      <FontIcon Glyph="&#xE896;"
                                FontSize="15" />
                    </Button>
                  </Grid>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
          </Grid>
        </Border>

        <Border Grid.Column="1"
                Style="{StaticResource SectionCardStyle}">
          <StackPanel Spacing="16">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock x:Name="CastTitle"
                         Style="{StaticResource SectionTitleText}" />
              <ProgressRing x:Name="CreditsLoadingRing"
                            Grid.Column="1"
                            Width="20"
                            Height="20"
                            IsActive="False"
                            Visibility="Collapsed" />
            </Grid>

            <TextBlock x:Name="CreditsStatusText"
                       Style="{StaticResource MetadataText}"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />

            <ItemsRepeater x:Name="CharactersList"
                           HorizontalAlignment="Stretch">
              <ItemsRepeater.Layout>
                <UniformGridLayout Orientation="Horizontal"
                                   MinItemWidth="176"
                                   MinItemHeight="104"
                                   MinColumnSpacing="10"
                                   MinRowSpacing="10"
                                   MaximumRowsOrColumns="2"
                                   ItemsJustification="SpaceBetween"
                                   ItemsStretch="Fill" />
              </ItemsRepeater.Layout>
              <ItemsRepeater.ItemTemplate>
                <DataTemplate>
                  <Border MinHeight="104"
                          Padding="10"
                          HorizontalAlignment="Stretch"
                          CornerRadius="8"
                          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                          BorderThickness="1">
                    <Grid ColumnDefinitions="58,*"
                          ColumnSpacing="10">
                      <Border Width="56"
                              Height="56"
                              CornerRadius="28"
                              Background="{ThemeResource EizoSelectionBrush}"
                              VerticalAlignment="Top">
                        <Grid>
                          <FontIcon Glyph="&#xE77B;"
                                    FontSize="22"
                                    Opacity="0.24"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                          <Image Source="{Binding Image}"
                                 Stretch="UniformToFill" />
                        </Grid>
                      </Border>
                      <StackPanel Grid.Column="1"
                                  Spacing="3">
                        <TextBlock Text="{Binding Name}"
                                   Style="{StaticResource CardTitleText}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Relation}"
                                   Style="{StaticResource MetadataText}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding ActorText}"
                                   Style="{StaticResource MetadataText}"
                                   TextWrapping="Wrap"
                                   MaxLines="2"
                                   TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <Border Height="1"
                    Margin="0,4,0,0"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <TextBlock x:Name="StaffTitle"
                       Style="{StaticResource SectionTitleText}" />

            <ItemsControl x:Name="StaffList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid MinHeight="42"
                        ColumnDefinitions="104,*"
                        ColumnSpacing="12">
                    <TextBlock Text="{Binding Relation}"
                               Style="{StaticResource MetadataText}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Name}"
                               Style="{StaticResource BodyText}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
