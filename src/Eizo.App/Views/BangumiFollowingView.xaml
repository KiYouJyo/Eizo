<UserControl x:Class="Eizo.Views.BangumiFollowingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Eizo.Controls">
  <Grid Padding="24,16,24,32"
        RowDefinitions="Auto,Auto,Auto,Auto,*,Auto"
        HorizontalAlignment="Stretch"
        UseLayoutRounding="True">
    <Grid ColumnDefinitions="*,Auto"
          ColumnSpacing="12">
      <StackPanel Spacing="4">
        <TextBlock x:Name="PageTitle"
                   Style="{StaticResource PageTitleText}" />
        <TextBlock x:Name="PageSubtitle"
                   Style="{StaticResource MetadataText}"
                   TextWrapping="Wrap" />
      </StackPanel>

      <Button x:Name="RefreshButton"
              Grid.Column="1"
              Height="36"
              MinWidth="96"
              Visibility="Collapsed"
              Click="RefreshButton_Click">
        <StackPanel Orientation="Horizontal"
                    Spacing="6">
          <FontIcon Glyph="&#xE72C;"
                    FontSize="12" />
          <TextBlock x:Name="RefreshButtonText" />
        </StackPanel>
      </Button>
    </Grid>

    <Border x:Name="AccountCard"
            Grid.Row="1"
            Margin="0,14,0,0"
            Padding="14"
            CornerRadius="10"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">
      <Grid ColumnDefinitions="Auto,*,Auto"
            ColumnSpacing="12">
        <Border Width="48"
                Height="48"
                CornerRadius="24"
                Background="{ThemeResource EizoSelectionBrush}">
          <Grid>
            <FontIcon Glyph="&#xE77B;"
                      FontSize="22"
                      Opacity="0.3" />
            <Image x:Name="AvatarImage"
                   Stretch="UniformToFill" />
          </Grid>
        </Border>

        <StackPanel Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="2">
          <TextBlock x:Name="AccountTitleText"
                     FontWeight="SemiBold" />
          <TextBlock x:Name="AccountSubtitleText"
                     Style="{StaticResource MetadataText}"
                     TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
          <Button x:Name="ConnectButton"
                  Click="ConnectButton_Click" />
          <Button x:Name="DisconnectButton"
                  Visibility="Collapsed"
                  Click="DisconnectButton_Click" />
        </StackPanel>
      </Grid>
    </Border>

    <ListView x:Name="CollectionSectionList"
              Grid.Row="2"
              Margin="0,10,0,0"
              SelectedIndex="2"
              IsItemClickEnabled="True"
              SelectionMode="Single"
              ScrollViewer.HorizontalScrollBarVisibility="Auto"
              ScrollViewer.HorizontalScrollMode="Auto"
              ScrollViewer.VerticalScrollBarVisibility="Disabled"
              ScrollViewer.VerticalScrollMode="Disabled"
              SelectionChanged="CollectionSectionList_SelectionChanged">
      <ListView.ItemsPanel>
        <ItemsPanelTemplate>
          <ItemsStackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </ListView.ItemsPanel>
      <ListView.ItemTemplate>
        <DataTemplate>
          <TextBlock Text="{Binding Label}"
                     Margin="8,2"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>

    <Grid Grid.Row="3"
          Margin="0,10,0,0"
          ColumnDefinitions="*,Auto">
      <TextBlock x:Name="StatusText"
                 Style="{StaticResource MetadataText}"
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                 TextWrapping="Wrap" />
      <ProgressRing x:Name="LoadingRing"
                    Grid.Column="1"
                    Width="22"
                    Height="22"
                    IsActive="False"
                    Visibility="Collapsed" />
    </Grid>

    <GridView x:Name="ResultsList"
              Grid.Row="4"
              Margin="0,12,0,0"
              ItemsPanel="{StaticResource PosterCardItemsPanelTemplate}"
              ItemContainerStyle="{StaticResource PosterCardGridViewItemStyle}"
              SelectionMode="None"
              IsItemClickEnabled="True"
              ItemClick="ResultsList_ItemClick"
              ScrollViewer.HorizontalScrollMode="Disabled"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <GridView.ItemTemplate>
        <DataTemplate>
          <controls:MediaPosterCard Artwork="{Binding Artwork}"
                                    IconGlyph="&#xE8B2;"
                                    BadgeText="{Binding TypeLabel}"
                                    Title="{Binding Title}"
                                    Subtitle="{Binding Subtitle}"
                                    MetaLine="{Binding MetaLine}"
                                    FooterLine="{Binding SourceLabel}" />
        </DataTemplate>
      </GridView.ItemTemplate>
    </GridView>

    <Button x:Name="LoadMoreButton"
            Grid.Row="5"
            Margin="0,8,0,0"
            HorizontalAlignment="Center"
            MinWidth="132"
            Height="36"
            Visibility="Collapsed"
            Click="LoadMoreButton_Click" />
  </Grid>
</UserControl>
