<UserControl x:Class="Eizo.Views.BangumiFollowingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Padding="24,16,24,32"
        RowDefinitions="Auto,Auto,Auto,*,Auto"
        HorizontalAlignment="Stretch"
        UseLayoutRounding="True">
    <Grid ColumnDefinitions="*,Auto"
          ColumnSpacing="12">
      <StackPanel Spacing="4">
        <TextBlock x:Name="PageTitle"
                   Style="{StaticResource PageTitleText}" />
        <TextBlock x:Name="PageSubtitle"
                   Style="{StaticResource MetadataText}"
                   TextWrapping="Wrap" />
      </StackPanel>

      <Button x:Name="RefreshButton"
              Grid.Column="1"
              Height="36"
              MinWidth="96"
              Visibility="Collapsed"
              Click="RefreshButton_Click">
        <StackPanel Orientation="Horizontal"
                    Spacing="6">
          <FontIcon Glyph="&#xE72C;"
                    FontSize="12" />
          <TextBlock x:Name="RefreshButtonText" />
        </StackPanel>
      </Button>
    </Grid>

    <Border x:Name="AccountCard"
            Grid.Row="1"
            Margin="0,14,0,0"
            Padding="14"
            CornerRadius="10"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">
      <Grid ColumnDefinitions="Auto,*,Auto"
            ColumnSpacing="12">
        <Border Width="48"
                Height="48"
                CornerRadius="24"
                Background="{ThemeResource EizoSelectionBrush}">
          <Grid>
            <FontIcon Glyph="&#xE77B;"
                      FontSize="22"
                      Opacity="0.3" />
            <Image x:Name="AvatarImage"
                   Stretch="UniformToFill" />
          </Grid>
        </Border>

        <StackPanel Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="2">
          <TextBlock x:Name="AccountTitleText"
                     FontWeight="SemiBold" />
          <TextBlock x:Name="AccountSubtitleText"
                     Style="{StaticResource MetadataText}"
                     TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
          <Button x:Name="ConnectButton"
                  Click="ConnectButton_Click" />
          <Button x:Name="DisconnectButton"
                  Visibility="Collapsed"
                  Click="DisconnectButton_Click" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="2"
          Margin="0,10,0,0"
          ColumnDefinitions="*,Auto">
      <TextBlock x:Name="StatusText"
                 Style="{StaticResource MetadataText}"
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                 TextWrapping="Wrap" />
      <ProgressRing x:Name="LoadingRing"
                    Grid.Column="1"
                    Width="22"
                    Height="22"
                    IsActive="False"
                    Visibility="Collapsed" />
    </Grid>

    <GridView x:Name="ResultsList"
              Grid.Row="3"
              Margin="0,12,0,0"
              SelectionMode="None"
              IsItemClickEnabled="True"
              ItemClick="ResultsList_ItemClick"
              ScrollViewer.HorizontalScrollMode="Disabled"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <GridView.ItemsPanel>
        <ItemsPanelTemplate>
          <ItemsWrapGrid Orientation="Horizontal"
                         ItemWidth="204"
                         ItemHeight="408" />
        </ItemsPanelTemplate>
      </GridView.ItemsPanel>

      <GridView.ItemContainerStyle>
        <Style TargetType="GridViewItem">
          <Setter Property="Width" Value="192" />
          <Setter Property="Height" Value="396" />
          <Setter Property="Padding" Value="0" />
          <Setter Property="Margin" Value="0,0,12,12" />
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          <Setter Property="VerticalContentAlignment" Value="Stretch" />
          <Setter Property="Background" Value="Transparent" />
        </Style>
      </GridView.ItemContainerStyle>

      <GridView.ItemTemplate>
        <DataTemplate>
          <Border CornerRadius="12"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1">
            <Grid RowDefinitions="272,124">
              <Border CornerRadius="11,11,0,0"
                      Background="{ThemeResource EizoSelectionBrush}">
                <Grid>
                  <FontIcon Glyph="&#xE8B2;"
                            FontSize="48"
                            Opacity="0.18"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                  <Image Source="{Binding Artwork}"
                         Stretch="UniformToFill" />
                  <Border HorizontalAlignment="Right"
                          VerticalAlignment="Top"
                          Margin="8"
                          Padding="7,3"
                          CornerRadius="10"
                          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <TextBlock Text="{Binding TypeLabel}"
                               FontSize="11"
                               FontWeight="SemiBold" />
                  </Border>
                </Grid>
              </Border>

              <StackPanel Grid.Row="1"
                          Padding="12,9"
                          Spacing="4">
                <TextBlock Text="{Binding Title}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           MaxLines="2"
                           TextWrapping="WrapWholeWords"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Subtitle}"
                           FontSize="11"
                           Opacity="0.62"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding MetaLine}"
                           FontSize="11"
                           Opacity="0.78"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding SourceLabel}"
                           FontSize="10.5"
                           Opacity="0.58"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </GridView.ItemTemplate>
    </GridView>

    <Button x:Name="LoadMoreButton"
            Grid.Row="4"
            Margin="0,8,0,0"
            HorizontalAlignment="Center"
            MinWidth="132"
            Height="36"
            Visibility="Collapsed"
            Click="LoadMoreButton_Click" />
  </Grid>
</UserControl>
