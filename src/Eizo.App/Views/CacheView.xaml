<UserControl x:Class="Eizo.Views.CacheView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="using:Eizo.Models">
 <ScrollViewer><Grid MaxWidth="1200" Margin="32" HorizontalAlignment="Stretch" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="18">
  <StackPanel Spacing="4"><TextBlock x:Name="PageTitle" Style="{StaticResource PageTitleText}"/><TextBlock x:Name="PageSubtitle" Style="{StaticResource MetadataText}"/></StackPanel>
  <Border Grid.Row="1" Style="{StaticResource SectionCardStyle}"><Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto"><StackPanel><TextBlock x:Name="OverviewTitle" Style="{StaticResource SectionTitleText}"/><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="8.6 GB" FontSize="30" FontWeight="SemiBold"/><TextBlock x:Name="OverviewLimit" Style="{StaticResource MetadataText}" VerticalAlignment="Bottom" Margin="0,0,0,5"/></StackPanel></StackPanel><Button x:Name="ClearCacheButton" Grid.Column="1" Style="{StaticResource CompactActionButton}"/><ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Value="27" Maximum="100" Height="6" Margin="0,12,0,8"/><Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="*,*,*"><TextBlock Text="Video 6.9 GB" Style="{StaticResource MetadataText}"/><TextBlock Grid.Column="1" Text="Artwork 1.7 GB" Style="{StaticResource MetadataText}"/><TextBlock Grid.Column="2" Text="26.9%" Style="{StaticResource MetadataText}" HorizontalAlignment="Right"/></Grid></Grid></Border>
  <Border Grid.Row="2" Style="{StaticResource SectionCardStyle}"><StackPanel Spacing="14"><TextBlock x:Name="PolicyTitle" Style="{StaticResource SectionTitleText}"/><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock x:Name="AutoCleanupTitle" Style="{StaticResource CardTitleText}"/><TextBlock x:Name="AutoCleanupDescription" Style="{StaticResource MetadataText}"/></StackPanel><ToggleSwitch Grid.Column="1" IsOn="True"/></Grid><Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock x:Name="PrecacheTitle" Style="{StaticResource CardTitleText}"/><TextBlock x:Name="PrecacheDescription" Style="{StaticResource MetadataText}"/></StackPanel><ComboBox Grid.Column="1" Width="150" SelectedIndex="2"><ComboBoxItem Content="64 MB"/><ComboBoxItem Content="128 MB"/><ComboBoxItem Content="256 MB"/><ComboBoxItem Content="512 MB"/><ComboBoxItem Content="1 GB"/></ComboBox></Grid><Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock x:Name="KeepOfflineTitle" Style="{StaticResource CardTitleText}"/><TextBlock x:Name="KeepOfflineDescription" Style="{StaticResource MetadataText}"/></StackPanel><ToggleSwitch Grid.Column="1" IsOn="True"/></Grid></StackPanel></Border>
  <StackPanel Grid.Row="3" Spacing="12"><TextBlock x:Name="ContentsTitle" Style="{StaticResource SectionTitleText}"/><ListView x:Name="CacheList" SelectionMode="None" ItemContainerStyle="{StaticResource SourceListItemStyle}"><ListView.ItemTemplate><DataTemplate x:DataType="models:CacheItemModel"><Grid Height="58" ColumnDefinitions="*,150,110,60"><StackPanel VerticalAlignment="Center"><TextBlock Text="{x:Bind Title}" Style="{StaticResource CardTitleText}"/><TextBlock Text="{x:Bind Source}" Style="{StaticResource MetadataText}"/></StackPanel><TextBlock Grid.Column="1" Text="{x:Bind Size}" VerticalAlignment="Center" Style="{StaticResource MetadataText}"/><TextBlock Grid.Column="2" Text="{x:Bind LastAccessed}" VerticalAlignment="Center" Style="{StaticResource MetadataText}"/><Button Grid.Column="3" Tag="{x:Bind Title}" Click="DeleteCacheItem_Click" Height="32" MinWidth="44"><FontIcon Glyph="&#xE74D;" FontSize="12"/></Button></Grid></DataTemplate></ListView.ItemTemplate></ListView></StackPanel>
 </Grid></ScrollViewer>
</UserControl>
