<UserControl x:Class="Eizo.Views.CacheView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:Eizo.Models"
             xmlns:controls="using:Eizo.Controls">
  <UserControl.Resources>
    <Style x:Key="CacheCardListItemStyle"
           TargetType="ListViewItem">
      <Setter Property="HorizontalContentAlignment"
              Value="Stretch" />
      <Setter Property="Padding"
              Value="0" />
      <Setter Property="Margin"
              Value="0,0,0,10" />
      <Setter Property="Background"
              Value="Transparent" />
    </Style>
  </UserControl.Resources>
  <ScrollViewer Background="Transparent"
                HorizontalScrollMode="Disabled"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalContentAlignment="Stretch"
                VerticalScrollBarVisibility="Auto">
    <Grid Padding="24,16,24,32"
          HorizontalAlignment="Stretch"
          UseLayoutRounding="True">
      <StackPanel Spacing="18"
                  HorizontalAlignment="Stretch">
        <StackPanel Spacing="4">
          <TextBlock x:Name="PageTitle"
                     Style="{StaticResource PageTitleText}" />
          <TextBlock x:Name="PageSubtitle"
                     Style="{StaticResource MetadataText}"
                     TextWrapping="Wrap" />
        </StackPanel>

        <Border Style="{StaticResource SettingsSectionCardStyle}">
          <Grid RowDefinitions="Auto,Auto,Auto">
            <StackPanel>
              <TextBlock x:Name="OverviewTitle"
                         Style="{StaticResource SectionTitleText}" />
              <StackPanel Orientation="Horizontal"
                          Spacing="8">
                <TextBlock x:Name="OverviewUsedText"
                           FontSize="30"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="OverviewLimit"
                           Style="{StaticResource MetadataText}"
                           VerticalAlignment="Bottom"
                           Margin="0,0,0,5" />
              </StackPanel>
            </StackPanel>

            <ProgressBar x:Name="CacheUsageProgress"
                         Grid.Row="1"
                         Value="0"
                         Maximum="100"
                         Height="6"
                         Margin="0,12,0,8" />

            <Grid Grid.Row="2"
                  ColumnDefinitions="*,*,Auto"
                  ColumnSpacing="16">
              <TextBlock x:Name="VideoCacheSizeText"
                         Style="{StaticResource MetadataText}" />
              <TextBlock x:Name="ApplicationCacheSizeText"
                         Grid.Column="1"
                         Style="{StaticResource MetadataText}" />
              <TextBlock x:Name="UsagePercentText"
                         Grid.Column="2"
                         Style="{StaticResource MetadataText}" />
            </Grid>
          </Grid>
        </Border>

        <Border Style="{StaticResource SettingsSectionCardStyle}">
          <Grid ColumnDefinitions="*,Auto"
                ColumnSpacing="24">
            <StackPanel Spacing="3"
                        VerticalAlignment="Center">
              <TextBlock x:Name="ApplicationCacheTitle"
                         Style="{StaticResource SectionTitleText}" />
              <TextBlock x:Name="ApplicationCacheDescription"
                         Style="{StaticResource MetadataText}"
                         TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="12"
                        VerticalAlignment="Center">
              <TextBlock x:Name="ApplicationCacheValue"
                         Style="{StaticResource CardTitleText}"
                         VerticalAlignment="Center" />
              <Button x:Name="ClearApplicationCacheButton"
                      Style="{StaticResource CompactActionButton}"
                      Click="ClearApplicationCacheButton_Click" />
            </StackPanel>
          </Grid>
        </Border>

        <Border Style="{StaticResource SettingsSectionCardStyle}">
          <StackPanel Spacing="14">
            <TextBlock x:Name="PolicyTitle"
                       Style="{StaticResource SectionTitleText}" />

            <Border Style="{StaticResource SettingsInnerCardStyle}">
              <StackPanel>
                <Grid Padding="14"
                      MinHeight="72"
                      ColumnDefinitions="*,Auto"
                      ColumnSpacing="24">
                  <StackPanel VerticalAlignment="Center"
                              Spacing="2">
                    <TextBlock x:Name="AutoCleanupTitle"
                               Style="{StaticResource SettingsRowLabelStyle}" />
                    <TextBlock x:Name="AutoCleanupDescription"
                               Style="{StaticResource SettingsDescriptionStyle}" />
                  </StackPanel>
                  <ToggleSwitch x:Name="AutoCleanupToggle"
                                Grid.Column="1"
                                Width="44"
                                MinWidth="44"
                                OnContent=""
                                OffContent=""
                                HorizontalAlignment="Right"
                                Toggled="AutoCleanupToggle_Toggled" />
                </Grid>

                <Border Height="1"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <Grid Padding="14"
                      MinHeight="72"
                      ColumnDefinitions="*,Auto"
                      ColumnSpacing="24">
                  <StackPanel VerticalAlignment="Center"
                              Spacing="2">
                    <TextBlock x:Name="CacheLimitTitle"
                               Style="{StaticResource SettingsRowLabelStyle}" />
                    <TextBlock x:Name="CacheLimitDescription"
                               Style="{StaticResource SettingsDescriptionStyle}" />
                  </StackPanel>
                  <ComboBox x:Name="CacheLimitCombo"
                            Grid.Column="1"
                            Width="180"
                            controls:TransientComboBoxTheme.Apply="True"
                            HorizontalAlignment="Right"
                            SelectionChanged="CacheLimitCombo_SelectionChanged">
                    <ComboBoxItem Content="8 GB" />
                    <ComboBoxItem Content="16 GB" />
                    <ComboBoxItem Content="32 GB" />
                    <ComboBoxItem Content="64 GB" />
                    <ComboBoxItem Content="128 GB" />
                  </ComboBox>
                </Grid>

                <Border Height="1"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <Grid Padding="14"
                      MinHeight="72"
                      ColumnDefinitions="*,Auto"
                      ColumnSpacing="24">
                  <StackPanel VerticalAlignment="Center"
                              Spacing="2">
                    <TextBlock x:Name="PrecacheTitle"
                               Style="{StaticResource SettingsRowLabelStyle}" />
                    <TextBlock x:Name="PrecacheDescription"
                               Style="{StaticResource SettingsDescriptionStyle}" />
                  </StackPanel>
                  <ComboBox x:Name="PrecacheSizeCombo"
                            Grid.Column="1"
                            Width="180"
                            controls:TransientComboBoxTheme.Apply="True"
                            HorizontalAlignment="Right"
                            SelectionChanged="PrecacheSizeCombo_SelectionChanged">
                    <ComboBoxItem Content="64 MB" />
                    <ComboBoxItem Content="128 MB" />
                    <ComboBoxItem Content="256 MB" />
                    <ComboBoxItem Content="512 MB" />
                    <ComboBoxItem Content="1 GB" />
                  </ComboBox>
                </Grid>

                <Border Height="1"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <Grid Padding="14"
                      MinHeight="72"
                      ColumnDefinitions="*,Auto"
                      ColumnSpacing="24">
                  <StackPanel VerticalAlignment="Center"
                              Spacing="2">
                    <TextBlock x:Name="KeepOfflineTitle"
                               Style="{StaticResource SettingsRowLabelStyle}" />
                    <TextBlock x:Name="KeepOfflineDescription"
                               Style="{StaticResource SettingsDescriptionStyle}" />
                  </StackPanel>
                  <ToggleSwitch x:Name="KeepOfflineToggle"
                                Grid.Column="1"
                                Width="44"
                                MinWidth="44"
                                OnContent=""
                                OffContent=""
                                HorizontalAlignment="Right"
                                Toggled="KeepOfflineToggle_Toggled" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <StackPanel Spacing="10"
                    Margin="0,0,0,24">
          <TextBlock x:Name="VideoCacheTitle"
                     Style="{StaticResource SectionTitleText}" />

          <TextBlock x:Name="EmptyStateText"
                     Style="{StaticResource MetadataText}"
                     Visibility="Collapsed"
                     Margin="4,8" />

          <TextBlock x:Name="CacheStatusText"
                     Style="{StaticResource MetadataText}"
                     Visibility="Collapsed"
                     Margin="4,8" />

          <ListView x:Name="CacheList"
                    SelectionMode="None"
                    IsItemClickEnabled="True"
                    ItemClick="CacheList_ItemClick"
                    ItemContainerStyle="{StaticResource CacheCardListItemStyle}">
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="models:CacheItemModel">
                <Border Style="{StaticResource SectionCardStyle}"
                        MinHeight="96"
                        Padding="16">
                  <Border.ContextFlyout>
                    <MenuFlyout>
                      <MenuFlyoutItem Text="{x:Bind DeleteText, Mode=OneWay}"
                                      Tag="{x:Bind Id}"
                                      Click="DeleteCacheItem_Click">
                        <MenuFlyoutItem.Icon>
                          <FontIcon Glyph="&#xE74D;" />
                        </MenuFlyoutItem.Icon>
                      </MenuFlyoutItem>
                    </MenuFlyout>
                  </Border.ContextFlyout>

                  <Grid ColumnDefinitions="*,Auto"
                        ColumnSpacing="20">
                    <StackPanel Spacing="7"
                                VerticalAlignment="Center">
                      <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                 Style="{StaticResource CardTitleText}"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{x:Bind Source, Mode=OneWay}"
                                 Style="{StaticResource MetadataText}"
                                 TextTrimming="CharacterEllipsis" />
                      <ProgressBar Value="{x:Bind ProgressPercent, Mode=OneWay}"
                                   Minimum="0"
                                   Maximum="100"
                                   Height="5" />
                      <TextBlock Text="{x:Bind ProgressText, Mode=OneWay}"
                                 Style="{StaticResource MetadataText}"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                MinWidth="120"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right"
                                Spacing="4">
                      <TextBlock Text="{x:Bind Status, Mode=OneWay}"
                                 Style="{StaticResource BodyText}"
                                 HorizontalAlignment="Right" />
                      <TextBlock Text="{x:Bind Size, Mode=OneWay}"
                                 Style="{StaticResource MetadataText}"
                                 HorizontalAlignment="Right" />
                      <TextBlock Text="{x:Bind LastAccessed, Mode=OneWay}"
                                 Style="{StaticResource MetadataText}"
                                 HorizontalAlignment="Right" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </StackPanel>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
