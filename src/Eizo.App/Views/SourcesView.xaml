<UserControl x:Class="Eizo.Views.SourcesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:Eizo.Models">
  <Grid Padding="24,16,24,32"
        HorizontalAlignment="Stretch"
        RowDefinitions="Auto,18,*"
        UseLayoutRounding="True">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="4">
        <TextBlock x:Name="PageTitle"
                   Style="{StaticResource PageTitleText}" />
        <TextBlock x:Name="PageSubtitle"
                   Style="{StaticResource MetadataText}" />
      </StackPanel>
      <Button x:Name="AddSourceButton"
              Grid.Column="1"
              VerticalAlignment="Top"
              Style="{StaticResource CompactActionButton}"
              Click="AddSourceButton_Click" />
    </Grid>

    <ListView x:Name="SourceList"
              Grid.Row="2"
              SelectionMode="None"
              IsItemClickEnabled="True"
              ItemClick="SourceList_ItemClick"
              ContainerContentChanging="SourceList_ContainerContentChanging"
              ScrollViewer.HorizontalScrollMode="Disabled"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListView.ItemContainerStyle>
        <Style TargetType="ListViewItem"
               BasedOn="{StaticResource SourceListItemStyle}">
          <Setter Property="MinHeight" Value="82" />
          <Setter Property="Padding" Value="18,14" />
          <Setter Property="Margin" Value="0,0,0,10" />
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          <Setter Property="VerticalContentAlignment" Value="Stretch" />
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderThickness" Value="0" />
          <Setter Property="UseSystemFocusVisuals" Value="False" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ListViewItem">
                <Grid>
                  <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                      <VisualState x:Name="Normal" />
                      <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                          <Setter Target="CardSurface.Background"
                                  Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                        </VisualState.Setters>
                      </VisualState>
                      <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                          <Setter Target="CardSurface.Background"
                                  Value="{ThemeResource ControlFillColorTertiaryBrush}" />
                        </VisualState.Setters>
                      </VisualState>
                      <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                          <Setter Target="CardSurface.Opacity"
                                  Value="0.55" />
                        </VisualState.Setters>
                      </VisualState>
                    </VisualStateGroup>
                  </VisualStateManager.VisualStateGroups>

                  <Border x:Name="CardSurface"
                          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                          CornerRadius="10"
                          Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      ContentTransitions="{TemplateBinding ContentTransitions}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                  </Border>
                </Grid>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </ListView.ItemContainerStyle>

      <ListView.ItemTemplate>
        <DataTemplate x:DataType="models:SourceItemModel">
          <Grid Height="52"
                ColumnDefinitions="*,260,116,116"
                ColumnSpacing="10">
            <StackPanel VerticalAlignment="Center"
                        Spacing="4">
              <TextBlock Text="{x:Bind Name, Mode=OneWay}"
                         Style="{StaticResource CardTitleText}"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{x:Bind Kind, Mode=OneWay}"
                         Style="{StaticResource MetadataText}"
                         Opacity="0.7"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <TextBlock Grid.Column="1"
                       Width="260"
                       Text="{x:Bind Summary, Mode=OneWay}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       TextAlignment="Right"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"
                       Style="{StaticResource MetadataText}" />

            <Button Grid.Column="2"
                    Tag="{x:Bind Id, Mode=OneWay}"
                    IsEnabled="{x:Bind CanScan, Mode=OneWay}"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    Height="32"
                    MinWidth="0"
                    MaxWidth="124"
                    Padding="12,0"
                    CornerRadius="5"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Click="ScanSourceButton_Click">
              <StackPanel Orientation="Horizontal"
                          Spacing="{x:Bind ScanSpacing, Mode=OneWay}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                <ProgressRing Width="{x:Bind ScanProgressSize, Mode=OneWay}"
                              Height="{x:Bind ScanProgressSize, Mode=OneWay}"
                              IsActive="{x:Bind IsScanning, Mode=OneWay}" />
                <TextBlock Text="{x:Bind ScanText, Mode=OneWay}"
                           VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <Button Grid.Column="3"
                    Tag="{x:Bind Id, Mode=OneWay}"
                    IsEnabled="{x:Bind CanScrape, Mode=OneWay}"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    Height="32"
                    MinWidth="0"
                    MaxWidth="112"
                    Padding="12,0"
                    CornerRadius="5"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Click="ScrapeSourceButton_Click">
              <StackPanel Orientation="Horizontal"
                          Spacing="{x:Bind ScrapeSpacing, Mode=OneWay}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                <ProgressRing Width="{x:Bind ScrapeProgressSize, Mode=OneWay}"
                              Height="{x:Bind ScrapeProgressSize, Mode=OneWay}"
                              IsActive="{x:Bind IsScraping, Mode=OneWay}" />
                <TextBlock Text="{x:Bind ScrapeText, Mode=OneWay}"
                           VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Grid>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>
  </Grid>
</UserControl>
