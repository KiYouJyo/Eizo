<UserControl x:Class="Eizo.Views.SourcesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:Eizo.Models">
  <Grid Padding="24,16,24,32"
        HorizontalAlignment="Stretch"
        RowDefinitions="Auto,18,*"
        UseLayoutRounding="True">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="4">
        <TextBlock x:Name="PageTitle"
                   Style="{StaticResource PageTitleText}" />
        <TextBlock x:Name="PageSubtitle"
                   Style="{StaticResource MetadataText}" />
      </StackPanel>
      <Button x:Name="AddSourceButton"
              Grid.Column="1"
              VerticalAlignment="Top"
              Style="{StaticResource CompactActionButton}"
              Click="AddSourceButton_Click" />
    </Grid>

    <ListView x:Name="SourceList"
              Grid.Row="2"
              SelectionMode="None"
              IsItemClickEnabled="True"
              ItemClick="SourceList_ItemClick"
              ContainerContentChanging="SourceList_ContainerContentChanging"
              ScrollViewer.HorizontalScrollMode="Disabled"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListView.ItemContainerStyle>
        <Style TargetType="ListViewItem"
               BasedOn="{StaticResource SourceListItemStyle}">
          <Setter Property="MinHeight" Value="82" />
          <Setter Property="Padding" Value="18,14" />
          <Setter Property="Margin" Value="0,0,0,10" />
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          <Setter Property="Background"
                  Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
          <Setter Property="BorderThickness" Value="0" />
          <Setter Property="CornerRadius" Value="10" />
          <Setter Property="UseSystemFocusVisuals" Value="False" />
        </Style>
      </ListView.ItemContainerStyle>

      <ListView.ItemTemplate>
        <DataTemplate x:DataType="models:SourceItemModel">
          <Grid MinHeight="52"
                ColumnDefinitions="*,Auto,Auto"
                ColumnSpacing="16">
            <StackPanel VerticalAlignment="Center"
                        Spacing="4">
              <TextBlock Text="{x:Bind Name}"
                         Style="{StaticResource CardTitleText}" />
              <TextBlock Text="{x:Bind Kind}"
                         Style="{StaticResource MetadataText}"
                         Opacity="0.7" />
            </StackPanel>

            <TextBlock Grid.Column="1"
                       Text="{x:Bind Summary}"
                       VerticalAlignment="Center"
                       TextAlignment="Right"
                       TextWrapping="Wrap"
                       MaxWidth="560"
                       Style="{StaticResource MetadataText}" />

            <Button Grid.Column="2"
                    Tag="{x:Bind Id}"
                    IsEnabled="{x:Bind CanScan}"
                    VerticalAlignment="Center"
                    Height="32"
                    MinWidth="0"
                    Padding="12,0"
                    CornerRadius="5"
                    Click="ScanSourceButton_Click">
              <StackPanel Orientation="Horizontal"
                          Spacing="{x:Bind ScanSpacing}"
                          VerticalAlignment="Center">
                <ProgressRing Width="{x:Bind ScanProgressSize}"
                              Height="{x:Bind ScanProgressSize}"
                              IsActive="{x:Bind IsScanning}" />
                <TextBlock Text="{x:Bind ScanText}"
                           VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Grid>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>
  </Grid>
</UserControl>
