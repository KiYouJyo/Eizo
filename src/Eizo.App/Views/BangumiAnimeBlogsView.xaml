<UserControl x:Class="Eizo.Views.BangumiAnimeBlogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Padding="24,16,24,28"
        RowDefinitions="Auto,Auto,12,*,Auto"
        HorizontalAlignment="Stretch">
    <Grid ColumnDefinitions="*,Auto"
          ColumnSpacing="10">
      <StackPanel Spacing="4">
        <TextBlock x:Name="PageTitle"
                   Style="{StaticResource PageTitleText}" />
        <TextBlock x:Name="PageSubtitle"
                   Style="{StaticResource MetadataText}"
                   TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Grid.Column="1"
                  Orientation="Horizontal"
                  Spacing="8"
                  VerticalAlignment="Center">
        <ProgressRing x:Name="LoadingRing"
                      Width="22"
                      Height="22"
                      IsActive="False"
                      Visibility="Collapsed" />
        <Button x:Name="RefreshButton"
                Click="RefreshButton_Click" />
        <Button x:Name="OpenBangumiButton"
                Click="OpenBangumiButton_Click" />
      </StackPanel>
    </Grid>

    <TextBlock x:Name="StatusText"
               Grid.Row="1"
               Margin="0,8,0,0"
               Style="{StaticResource MetadataText}"
               TextWrapping="Wrap" />

    <ScrollViewer Grid.Row="3"
                  HorizontalScrollMode="Disabled"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollMode="Auto"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalContentAlignment="Stretch">
      <ItemsControl x:Name="BlogsList"
                    HorizontalAlignment="Stretch">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Padding="0"
                    Margin="0,0,0,10"
                    Tag="{Binding Blog}"
                    Click="BlogItem_Click">
              <Border Padding="14"
                      CornerRadius="10"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1">
                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="12">
                  <Border Width="44"
                          Height="44"
                          CornerRadius="22"
                          Background="{ThemeResource EizoSelectionBrush}"
                          VerticalAlignment="Top">
                    <Grid>
                      <FontIcon Glyph="&#xE77B;"
                                FontSize="18"
                                Opacity="0.28" />
                      <Image Source="{Binding Avatar}"
                             Stretch="UniformToFill" />
                    </Grid>
                  </Border>

                  <StackPanel Grid.Column="1"
                              Spacing="5">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="8">
                      <TextBlock Text="{Binding Title}"
                                 FontSize="17"
                                 FontWeight="SemiBold"
                                 TextWrapping="Wrap" />
                      <TextBlock Grid.Column="1"
                                 Text="{Binding MetaLine}"
                                 Style="{StaticResource MetadataText}"
                                 VerticalAlignment="Top"
                                 TextWrapping="Wrap" />
                    </Grid>

                    <TextBlock Text="{Binding UserName}"
                               Style="{StaticResource MetadataText}" />

                    <TextBlock Text="{Binding Summary}"
                               Style="{StaticResource BodyText}"
                               TextWrapping="Wrap"
                               MaxLines="5"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>
              </Border>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Button x:Name="LoadMoreButton"
            Grid.Row="4"
            Margin="0,10,0,0"
            MinWidth="132"
            Height="36"
            HorizontalAlignment="Center"
            Visibility="Collapsed"
            Click="LoadMoreButton_Click" />
  </Grid>
</UserControl>
