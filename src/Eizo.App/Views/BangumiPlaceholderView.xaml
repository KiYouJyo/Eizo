<UserControl x:Class="Eizo.Views.BangumiPlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer Background="Transparent"
                HorizontalScrollMode="Disabled"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalContentAlignment="Stretch"
                VerticalScrollBarVisibility="Auto">
    <Grid Padding="24,16,24,32"
          HorizontalAlignment="Stretch"
          UseLayoutRounding="True">
      <StackPanel Spacing="18"
                  HorizontalAlignment="Stretch">
        <StackPanel Spacing="4">
          <TextBlock x:Name="PageTitle"
                     Style="{StaticResource PageTitleText}" />
          <TextBlock x:Name="PageSubtitle"
                     Style="{StaticResource MetadataText}" />
        </StackPanel>

        <Border Style="{StaticResource SettingsSectionCardStyle}">
          <Grid Padding="20"
                ColumnDefinitions="56,*"
                ColumnSpacing="18">
            <Border Width="48"
                    Height="48"
                    CornerRadius="12"
                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                    VerticalAlignment="Top">
              <FontIcon x:Name="PlaceholderIcon"
                        FontSize="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="1"
                        Spacing="6"
                        VerticalAlignment="Center">
              <TextBlock x:Name="StatusText"
                         Style="{StaticResource SectionTitleText}" />
              <TextBlock x:Name="DescriptionText"
                         Style="{StaticResource SettingsDescriptionStyle}"
                         TextWrapping="Wrap"
                         MaxWidth="760"
                         HorizontalAlignment="Left" />
            </StackPanel>
          </Grid>
        </Border>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
