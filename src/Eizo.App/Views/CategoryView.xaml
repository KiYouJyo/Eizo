<UserControl x:Class="Eizo.Views.CategoryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="using:Eizo.Models">
 <ScrollViewer><Grid MaxWidth="1200" Margin="32" HorizontalAlignment="Stretch" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="18">
  <Grid ColumnDefinitions="*,380"><StackPanel Spacing="4"><TextBlock x:Name="PageTitle" Style="{StaticResource PageTitleText}"/><TextBlock x:Name="PageSubtitle" Style="{StaticResource MetadataText}"/></StackPanel><AutoSuggestBox x:Name="SearchBox" Grid.Column="1" Height="38" QueryIcon="Find"/></Grid>
  <Button x:Name="FeaturedButton" Grid.Row="1" Style="{StaticResource HeroCardButton}" Click="FeaturedButton_Click"><Grid ColumnDefinitions="420,*"><Border Margin="12" CornerRadius="8" Background="{ThemeResource EizoSelectionBrush}"><FontIcon Glyph="&#xE8B9;" FontSize="68" Opacity="0.22"/></Border><StackPanel Grid.Column="1" Padding="24" Spacing="10" VerticalAlignment="Center"><TextBlock x:Name="FeaturedTitle" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="FeaturedNativeTitle" Style="{StaticResource BodyText}"/><TextBlock x:Name="FeaturedMeta" Style="{StaticResource MetadataText}"/><TextBlock x:Name="FeaturedDescription" Style="{StaticResource BodyText}" TextWrapping="Wrap"/><Button x:Name="FeaturedPlayButton" Width="96" HorizontalAlignment="Left" Style="{StaticResource CompactActionButton}" Click="FeaturedPlayButton_Click"/></StackPanel></Grid></Button>
  <StackPanel Grid.Row="2" Spacing="12"><TextBlock x:Name="LibraryTitle" Style="{StaticResource SectionTitleText}"/><ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled"><StackPanel Orientation="Horizontal"><ToggleButton x:Name="AllFilter" IsChecked="True" Style="{StaticResource FilterToggleButton}"/><ToggleButton x:Name="CurrentFilter" Style="{StaticResource FilterToggleButton}"/><ToggleButton x:Name="FollowingFilter" Style="{StaticResource FilterToggleButton}"/><ToggleButton x:Name="UnwatchedFilter" Style="{StaticResource FilterToggleButton}"/><ToggleButton x:Name="SpecialFilter" Style="{StaticResource FilterToggleButton}"/></StackPanel></ScrollViewer></StackPanel>
  <ItemsRepeater x:Name="LibraryRepeater" Grid.Row="3"><ItemsRepeater.Layout><UniformGridLayout MinItemWidth="250" MinItemHeight="174" MinColumnSpacing="12" MinRowSpacing="12" ItemsStretch="Fill"/></ItemsRepeater.Layout><ItemsRepeater.ItemTemplate><DataTemplate x:DataType="models:MediaCardModel"><Button Style="{StaticResource MediaCardButton}" Height="174" Tag="{x:Bind Title}" Click="MediaCard_Click"><Grid RowDefinitions="104,*"><Border Background="{ThemeResource EizoSelectionBrush}" CornerRadius="8,8,0,0"><FontIcon Glyph="&#xE8B9;" FontSize="34" Opacity="0.25"/></Border><Grid Grid.Row="1" Padding="12,8" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto"><TextBlock Text="{x:Bind NativeTitle}" Style="{StaticResource CardTitleText}"/><TextBlock Grid.Row="1" Text="{x:Bind Title}" Style="{StaticResource MetadataText}"/><TextBlock Grid.Column="1" Grid.Row="1" Text="{x:Bind Meta}" Style="{StaticResource MetadataText}"/></Grid></Grid></Button></DataTemplate></ItemsRepeater.ItemTemplate></ItemsRepeater>
 </Grid></ScrollViewer>
</UserControl>
