<UserControl x:Class="Eizo.Views.PlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:Eizo.Models"
             xmlns:controls="using:Eizo.Controls"
             xmlns:playback="using:Eizo.Playback.WinUI">
  <Grid x:Name="PlayerRoot"
        ColumnDefinitions="*,Auto"
        Background="Transparent">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup>
        <VisualState x:Name="PlayerCompact">
          <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="PlayerSidebar.Visibility" Value="Collapsed" />
            <Setter Target="QuickControls.Visibility" Value="Collapsed" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="PlayerWide">
          <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="900" /></VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="PlayerSidebar.Visibility" Value="Visible" />
            <Setter Target="QuickControls.Visibility" Value="Visible" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <Grid Margin="16"
          RowDefinitions="64,*,108"
          Background="{ThemeResource EizoAppBrush}"
          CornerRadius="8">
      <Grid Padding="20,0"
            ColumnDefinitions="*,Auto">
        <StackPanel VerticalAlignment="Center" Spacing="2">
          <TextBlock x:Name="NowPlayingTitle" Style="{StaticResource CardTitleText}" />
          <TextBlock x:Name="NowPlayingEpisode" Style="{StaticResource MetadataText}" />
        </StackPanel>

        <Button x:Name="OpenMediaButton"
                Grid.Column="1"
                Width="40"
                Height="36"
                Padding="0"
                Click="OpenMediaButton_Click">
          <FontIcon Glyph="&#xE8E5;" FontSize="14" />
        </Button>
      </Grid>

      <Grid x:Name="PlaybackSurfaceHost"
            Grid.Row="1"
            Background="#080D0E">
        <playback:PlaybackView x:Name="PlaybackSurface"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Stretch" />

        <Border x:Name="PlaybackStatusPanel"
                MaxWidth="520"
                Padding="18,12"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="8"
                Background="#B3000000">
          <TextBlock x:Name="PlaybackStatusText"
                     TextAlignment="Center"
                     TextWrapping="Wrap" />
        </Border>
      </Grid>

      <Grid Grid.Row="2"
            Padding="20,10"
            RowDefinitions="Auto,*">
        <Grid>
          <Slider x:Name="PlaybackSlider"
                  Minimum="0"
                  Maximum="1"
                  Value="0"
                  StepFrequency="1"
                  ValueChanged="PlaybackSlider_ValueChanged" />
          <TextBlock x:Name="CurrentTimeText"
                     Style="{StaticResource MetadataText}"
                     VerticalAlignment="Bottom"
                     Margin="0,28,0,0" />
          <TextBlock x:Name="DurationText"
                     Style="{StaticResource MetadataText}"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Bottom"
                     Margin="0,28,0,0" />
        </Grid>

        <Grid Grid.Row="1"
              ColumnDefinitions="*,Auto,*"
              Margin="0,8,0,0">
          <StackPanel Grid.Column="1"
                      Orientation="Horizontal"
                      Spacing="4">
            <Button x:Name="PreviousChapterButton"
                    Width="48"
                    Height="36"
                    Click="PreviousChapterButton_Click">
              <FontIcon Glyph="&#xE892;" FontSize="12" />
            </Button>
            <Button x:Name="PreviousJumpButton"
                    Width="44"
                    Height="36"
                    Click="PreviousJumpButton_Click">
              <FontIcon Glyph="&#xE100;" FontSize="12" />
            </Button>
            <Button x:Name="PlayPauseButton"
                    Width="44"
                    Height="36"
                    Click="PlayPauseButton_Click">
              <FontIcon x:Name="PlayPauseIcon"
                        Glyph="&#xE768;"
                        FontSize="12" />
            </Button>
            <Button x:Name="StopButton"
                    Width="44"
                    Height="36"
                    Click="StopButton_Click">
              <FontIcon Glyph="&#xE71A;" FontSize="12" />
            </Button>
            <Button x:Name="NextChapterButton"
                    Width="48"
                    Height="36"
                    Click="NextChapterButton_Click">
              <FontIcon Glyph="&#xE893;" FontSize="12" />
            </Button>
          </StackPanel>

          <StackPanel x:Name="QuickControls"
                      Grid.Column="2"
                      Orientation="Horizontal"
                      Spacing="4"
                      HorizontalAlignment="Right"
                      Visibility="Collapsed">
            <Button x:Name="SubtitleQuickButton" Height="36" />
            <Button x:Name="AudioQuickButton" Height="36" />
            <Button x:Name="PlaybackRateButton"
                    Content="1.0×"
                    Height="36"
                    Click="PlaybackRateButton_Click" />
            <Button Height="36"><FontIcon Glyph="&#xE740;" FontSize="12" /></Button>
          </StackPanel>
        </Grid>
      </Grid>
    </Grid>

    <Border x:Name="PlayerSidebar"
            Grid.Column="1"
            Width="300"
            Visibility="Collapsed"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1,0,0,0">
      <Grid Padding="16"
            RowDefinitions="Auto,Auto,*,Auto">
        <StackPanel>
          <TextBlock x:Name="QueueTitle" Style="{StaticResource SectionTitleText}" />
          <TextBlock x:Name="QueueSubtitle" Style="{StaticResource MetadataText}" />
        </StackPanel>

        <ListView x:Name="PlayerSectionList"
                  Grid.Row="1"
                  Margin="0,10,0,10"
                  SelectedIndex="0"
                  IsItemClickEnabled="True"
                  SelectionMode="Single"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.HorizontalScrollMode="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                  ScrollViewer.VerticalScrollMode="Disabled">
          <ListView.ItemsPanel>
            <ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
          </ListView.ItemsPanel>
          <ListView.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}"
                         Margin="8,2"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>

        <ListView x:Name="QueueList"
                  Grid.Row="2"
                  SelectionMode="Single"
                  SelectedIndex="0"
                  ItemContainerStyle="{StaticResource SourceListItemStyle}">
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="models:EpisodeItemModel">
              <Grid Height="58" ColumnDefinitions="44,*">
                <TextBlock Text="{x:Bind Number}"
                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">
                  <TextBlock Text="{x:Bind Title}" Style="{StaticResource CardTitleText}" />
                  <TextBlock Text="{x:Bind Status}" Style="{StaticResource MetadataText}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="3"
                    Spacing="8"
                    Margin="0,14,0,0">
          <TextBlock x:Name="PlaybackInfoTitle" Style="{StaticResource CardTitleText}" />
          <ComboBox x:Name="SubtitleTrackCombo"
                    controls:TransientComboBoxTheme.Apply="True"
                    SelectionChanged="SubtitleTrackCombo_SelectionChanged" />
          <ComboBox x:Name="AudioTrackCombo"
                    controls:TransientComboBoxTheme.Apply="True"
                    SelectionChanged="AudioTrackCombo_SelectionChanged" />
          <TextBlock x:Name="VideoInfoText"
                     Style="{StaticResource MetadataText}"
                     TextWrapping="Wrap" />
          <TextBlock x:Name="SourceInfoText"
                     Style="{StaticResource MetadataText}"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
