<UserControl x:Class="Eizo.Views.PlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:Eizo.Models">
  <Grid x:Name="PlayerRoot"
        ColumnDefinitions="*,Auto"
        Background="Transparent">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup>
        <VisualState x:Name="PlayerCompact">
          <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="PlayerSidebar.Visibility" Value="Collapsed" />
            <Setter Target="QuickControls.Visibility" Value="Collapsed" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="PlayerWide">
          <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="900" /></VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="PlayerSidebar.Visibility" Value="Visible" />
            <Setter Target="QuickControls.Visibility" Value="Visible" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <Grid Margin="16"
          RowDefinitions="64,*,108"
          Background="{ThemeResource EizoAppBrush}"
          CornerRadius="8">
      <Grid Padding="20,0">
        <StackPanel VerticalAlignment="Center" Spacing="2">
          <TextBlock x:Name="NowPlayingTitle" Style="{StaticResource CardTitleText}" />
          <TextBlock x:Name="NowPlayingEpisode" Style="{StaticResource MetadataText}" />
        </StackPanel>
      </Grid>

      <Grid x:Name="PlaybackSurfaceHost"
            Grid.Row="1"
            Background="#080D0E">
        <Border MaxWidth="760"
                Height="88"
                Margin="48,0,48,26"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Stretch"
                CornerRadius="6"
                Background="#66000000">
          <StackPanel VerticalAlignment="Center" Spacing="4">
            <TextBlock Text="芙莉莲：寻找魔法的时候，才是最有趣的。"
                       TextAlignment="Center"
                       FontSize="17"
                       TextWrapping="Wrap" />
            <TextBlock Text="フリーレン：魔法は探し求めている時が、一番楽しいんだ。"
                       TextAlignment="Center"
                       FontSize="12"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </Grid>

      <Grid Grid.Row="2"
            Padding="20,10"
            RowDefinitions="Auto,*">
        <Grid>
          <Slider Minimum="0"
                  Maximum="1421"
                  Value="728"
                  StepFrequency="1" />
          <TextBlock Text="12:08"
                     Style="{StaticResource MetadataText}"
                     VerticalAlignment="Bottom"
                     Margin="0,28,0,0" />
          <TextBlock Text="23:41"
                     Style="{StaticResource MetadataText}"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Bottom"
                     Margin="0,28,0,0" />
        </Grid>

        <Grid Grid.Row="1"
              ColumnDefinitions="*,Auto,*"
              Margin="0,8,0,0">
          <StackPanel Grid.Column="1"
                      Orientation="Horizontal"
                      Spacing="4">
            <Button Width="48" Height="36"><FontIcon Glyph="&#xE892;" FontSize="12" /></Button>
            <Button Width="44" Height="36"><FontIcon Glyph="&#xE100;" FontSize="12" /></Button>
            <Button Width="44" Height="36"><FontIcon Glyph="&#xE769;" FontSize="12" /></Button>
            <Button Width="44" Height="36"><FontIcon Glyph="&#xE101;" FontSize="12" /></Button>
            <Button Width="48" Height="36"><FontIcon Glyph="&#xE893;" FontSize="12" /></Button>
          </StackPanel>

          <StackPanel x:Name="QuickControls"
                      Grid.Column="2"
                      Orientation="Horizontal"
                      Spacing="4"
                      HorizontalAlignment="Right"
                      Visibility="Collapsed">
            <Button x:Name="SubtitleQuickButton" Height="36" />
            <Button x:Name="AudioQuickButton" Height="36" />
            <Button Content="1.0×" Height="36" />
            <Button Height="36"><FontIcon Glyph="&#xE740;" FontSize="12" /></Button>
          </StackPanel>
        </Grid>
      </Grid>
    </Grid>

    <Border x:Name="PlayerSidebar"
            Grid.Column="1"
            Width="300"
            Visibility="Collapsed"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1,0,0,0">
      <Grid Padding="16"
            RowDefinitions="Auto,Auto,*,Auto">
        <StackPanel>
          <TextBlock x:Name="QueueTitle" Style="{StaticResource SectionTitleText}" />
          <TextBlock x:Name="QueueSubtitle" Style="{StaticResource MetadataText}" />
        </StackPanel>

        <ListView x:Name="PlayerSectionList"
                  Grid.Row="1"
                  Margin="0,10,0,10"
                  SelectedIndex="0"
                  IsItemClickEnabled="True"
                  SelectionMode="Single"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.HorizontalScrollMode="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                  ScrollViewer.VerticalScrollMode="Disabled">
          <ListView.ItemsPanel>
            <ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
          </ListView.ItemsPanel>
          <ListView.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}"
                         Margin="8,2"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>

        <ListView x:Name="QueueList"
                  Grid.Row="2"
                  SelectionMode="Single"
                  SelectedIndex="0"
                  ItemContainerStyle="{StaticResource SourceListItemStyle}">
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="models:EpisodeItemModel">
              <Grid Height="58" ColumnDefinitions="44,*">
                <TextBlock Text="{x:Bind Number}"
                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">
                  <TextBlock Text="{x:Bind Title}" Style="{StaticResource CardTitleText}" />
                  <TextBlock Text="{x:Bind Status}" Style="{StaticResource MetadataText}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="3"
                    Spacing="8"
                    Margin="0,14,0,0">
          <TextBlock x:Name="PlaybackInfoTitle" Style="{StaticResource CardTitleText}" />
          <ComboBox SelectedIndex="0"><ComboBoxItem Content="简体中文 · ASS" /></ComboBox>
          <ComboBox SelectedIndex="0"><ComboBoxItem Content="日本語 · FLAC 2.0" /></ComboBox>
          <TextBlock Text="4K · HEVC 10-bit · HDR10" Style="{StaticResource MetadataText}" />
          <TextBlock Text="WebDAV · NAS · 38 Mbps" Style="{StaticResource MetadataText}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
