<UserControl x:Class="Eizo.Views.PlayerView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="using:Eizo.Models">
 <Grid ColumnDefinitions="*,300" Background="Transparent">
  <Grid Margin="16" RowDefinitions="64,*,108" Background="{ThemeResource EizoAppBrush}" CornerRadius="8">
   <Grid Padding="20,0"><StackPanel VerticalAlignment="Center" Spacing="2"><TextBlock x:Name="NowPlayingTitle" Style="{StaticResource CardTitleText}"/><TextBlock x:Name="NowPlayingEpisode" Style="{StaticResource MetadataText}"/></StackPanel></Grid>
   <Grid x:Name="PlaybackSurfaceHost" Grid.Row="1" Background="#080D0E"><Border Width="760" Height="88" VerticalAlignment="Bottom" Margin="0,0,0,26" HorizontalAlignment="Center" CornerRadius="6" Background="#66000000"><StackPanel VerticalAlignment="Center" Spacing="4"><TextBlock Text="芙莉莲：寻找魔法的时候，才是最有趣的。" TextAlignment="Center" FontSize="17"/><TextBlock Text="フリーレン：魔法は探し求めている時が、一番楽しいんだ。" TextAlignment="Center" FontSize="12"/></StackPanel></Border></Grid>
   <Grid Grid.Row="2" Padding="20,10" RowDefinitions="Auto,*"><Grid><Slider Minimum="0" Maximum="1421" Value="728" StepFrequency="1"/><TextBlock Text="12:08" Style="{StaticResource MetadataText}" VerticalAlignment="Bottom" Margin="0,28,0,0"/><TextBlock Text="23:41" Style="{StaticResource MetadataText}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,28,0,0"/></Grid><Grid Grid.Row="1" ColumnDefinitions="*,Auto,*" Margin="0,8,0,0"><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"><Button Width="48" Height="36"><FontIcon Glyph="&#xE892;" FontSize="12"/></Button><Button Width="44" Height="36"><FontIcon Glyph="&#xE100;" FontSize="12"/></Button><Button Width="44" Height="36"><FontIcon Glyph="&#xE769;" FontSize="12"/></Button><Button Width="44" Height="36"><FontIcon Glyph="&#xE101;" FontSize="12"/></Button><Button Width="48" Height="36"><FontIcon Glyph="&#xE893;" FontSize="12"/></Button></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right"><Button x:Name="SubtitleQuickButton" Height="36"/><Button x:Name="AudioQuickButton" Height="36"/><Button Content="1.0×" Height="36"/><Button Height="36"><FontIcon Glyph="&#xE740;" FontSize="12"/></Button></StackPanel></Grid></Grid>
  </Grid>
  <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0"><Grid Padding="16" RowDefinitions="Auto,Auto,*,Auto"><StackPanel><TextBlock x:Name="QueueTitle" Style="{StaticResource SectionTitleText}"/><TextBlock x:Name="QueueSubtitle" Style="{StaticResource MetadataText}"/></StackPanel><StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,12,0,10"><ToggleButton x:Name="QueueTab" IsChecked="True" Style="{StaticResource FilterToggleButton}"/><ToggleButton x:Name="TracksTab" Style="{StaticResource FilterToggleButton}"/></StackPanel><ListView x:Name="QueueList" Grid.Row="2" SelectionMode="Single" SelectedIndex="0" ItemContainerStyle="{StaticResource SourceListItemStyle}"><ListView.ItemTemplate><DataTemplate x:DataType="models:EpisodeItemModel"><Grid Height="58" ColumnDefinitions="44,*"><TextBlock Text="{x:Bind Number}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{x:Bind Title}" Style="{StaticResource CardTitleText}"/><TextBlock Text="{x:Bind Status}" Style="{StaticResource MetadataText}"/></StackPanel></Grid></DataTemplate></ListView.ItemTemplate></ListView><StackPanel Grid.Row="3" Spacing="8" Margin="0,14,0,0"><TextBlock x:Name="PlaybackInfoTitle" Style="{StaticResource CardTitleText}"/><ComboBox SelectedIndex="0"><ComboBoxItem Content="简体中文 · ASS"/></ComboBox><ComboBox SelectedIndex="0"><ComboBoxItem Content="日本語 · FLAC 2.0"/></ComboBox><TextBlock Text="4K · HEVC 10-bit · HDR10" Style="{StaticResource MetadataText}"/><TextBlock Text="WebDAV · NAS · 38 Mbps" Style="{StaticResource MetadataText}"/></StackPanel></Grid></Border>
 </Grid>
</UserControl>
