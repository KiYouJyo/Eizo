<UserControl x:Class="Eizo.Views.PlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:Eizo.Models"
             xmlns:controls="using:Eizo.Controls"
             xmlns:playback="using:Eizo.Playback.WinUI"
             IsTabStop="True"
             KeyDown="PlayerView_KeyDown">
  <Grid x:Name="PlayerRoot"
        Background="Transparent"
        PointerMoved="PlayerRoot_PointerMoved"
        SizeChanged="PlayerRoot_SizeChanged">
    <SplitView x:Name="PlayerSplitView"
               PanePlacement="Right"
               OpenPaneLength="300"
               CompactPaneLength="0"
               DisplayMode="Inline"
               IsPaneOpen="False">
      <SplitView.Content>
        <Grid x:Name="PlayerContentRoot">
          <Grid x:Name="PlayerFrame"
          Margin="16"
          Background="{ThemeResource EizoAppBrush}"
          CornerRadius="8">
      <Grid.RowDefinitions>
        <RowDefinition x:Name="HeaderRow" Height="64" />
        <RowDefinition Height="*" />
        <RowDefinition x:Name="ControlsRow" Height="108" />
      </Grid.RowDefinitions>

      <Grid x:Name="PlayerHeader"
            Grid.Row="0"
            Padding="20,0">
        <StackPanel VerticalAlignment="Center" Spacing="2">
          <TextBlock x:Name="NowPlayingTitle" Style="{StaticResource CardTitleText}" />
          <TextBlock x:Name="NowPlayingEpisode" Style="{StaticResource MetadataText}" />
        </StackPanel>
      </Grid>

      <Grid x:Name="PlaybackSurfaceHost"
            Grid.Row="1"
            Background="#080D0E"
            SizeChanged="PlaybackSurfaceHost_SizeChanged">
        <playback:PlaybackView x:Name="PlaybackSurface"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Stretch" />

        <Border x:Name="SecondarySubtitleOverlay"
                Margin="36,0,36,0"
                Padding="14,7"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom"
                Background="#B0000000"
                CornerRadius="6"
                IsHitTestVisible="False"
                Visibility="Collapsed"
                SizeChanged="SubtitleOverlay_SizeChanged">
          <TextBlock x:Name="SecondarySubtitleText"
                     Foreground="White"
                     FontSize="20"
                     FontWeight="SemiBold"
                     TextAlignment="Center"
                     TextWrapping="Wrap" />
        </Border>

        <Border x:Name="PrimarySubtitleOverlay"
                Margin="36,0,36,0"
                Padding="14,7"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom"
                Background="#B0000000"
                CornerRadius="6"
                IsHitTestVisible="False"
                Visibility="Collapsed"
                SizeChanged="SubtitleOverlay_SizeChanged">
          <TextBlock x:Name="PrimarySubtitleText"
                     Foreground="White"
                     FontSize="20"
                     FontWeight="SemiBold"
                     TextAlignment="Center"
                     TextWrapping="Wrap" />
        </Border>

        <Border x:Name="PlaybackStatusPanel"
                MinWidth="210"
                MaxWidth="520"
                Padding="18,14"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="10"
                Background="{ThemeResource AppTransientSurfaceBrush}"
                BorderBrush="{ThemeResource AppTransientSurfaceBorderBrush}"
                BorderThickness="1">
          <StackPanel Spacing="8"
                      HorizontalAlignment="Center">
            <ProgressRing x:Name="PlaybackLoadingRing"
                          Width="28"
                          Height="28"
                          Minimum="0"
                          Maximum="100"
                          IsActive="True"
                          IsIndeterminate="True"
                          HorizontalAlignment="Center" />
            <TextBlock x:Name="PlaybackStatusText"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="PlaybackLoadingMetricsText"
                       Visibility="Collapsed"
                       Style="{StaticResource MetadataText}"
                       TextAlignment="Center"
                       HorizontalAlignment="Center" />
          </StackPanel>
        </Border>
      </Grid>

      <Grid x:Name="PlayerControlsPanel"
            Grid.Row="2"
            Padding="20,10"
            RowDefinitions="Auto,*"
            PointerEntered="PlayerControlsPanel_PointerEntered"
            PointerExited="PlayerControlsPanel_PointerExited">
        <Grid>
          <Slider x:Name="PlaybackSlider"
                  Minimum="0"
                  Maximum="1"
                  Value="0"
                  StepFrequency="1"
                  ValueChanged="PlaybackSlider_ValueChanged" />
          <TextBlock x:Name="CurrentTimeText"
                     Style="{StaticResource MetadataText}"
                     VerticalAlignment="Bottom"
                     Margin="0,28,0,0" />
          <TextBlock x:Name="DurationText"
                     Style="{StaticResource MetadataText}"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Bottom"
                     Margin="0,28,0,0" />
        </Grid>

        <Grid x:Name="PlaybackButtonsGrid"
              Grid.Row="1"
              Margin="0,8,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftPlaybackColumn" Width="Auto" />
            <ColumnDefinition x:Name="CenterPlaybackColumn" Width="*" />
            <ColumnDefinition x:Name="RightPlaybackColumn" Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <StackPanel x:Name="LeftPlaybackControls"
                      Grid.Column="0"
                      Orientation="Horizontal"
                      Spacing="4"
                      HorizontalAlignment="Left">
            <Button x:Name="PlaybackRateButton"
                    Content="1.0×"
                    Height="36"
                    MinWidth="64">
              <Button.Flyout>
                <Flyout Placement="Top">
                  <StackPanel Width="260" Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock x:Name="PlaybackRateFlyoutTitle"
                                 VerticalAlignment="Center"
                                 FontWeight="SemiBold" />
                      <TextBlock x:Name="PlaybackRateValueText"
                                 Grid.Column="1"
                                 Text="1.00×"
                                 VerticalAlignment="Center" />
                    </Grid>
                    <Slider x:Name="PlaybackRateSlider"
                            Minimum="0"
                            Maximum="1"
                            Value="0.5"
                            StepFrequency="0.025"
                            SmallChange="0.025"
                            LargeChange="0.1"
                            ValueChanged="PlaybackRateSlider_ValueChanged" />
                    <Grid ColumnDefinitions="*,*,*">
                      <TextBlock Text="0.5×"
                                 HorizontalAlignment="Left"
                                 Style="{StaticResource MetadataText}" />
                      <TextBlock Grid.Column="1"
                                 Text="1.0×"
                                 HorizontalAlignment="Center"
                                 Style="{StaticResource MetadataText}" />
                      <TextBlock Grid.Column="2"
                                 Text="2.0×"
                                 HorizontalAlignment="Right"
                                 Style="{StaticResource MetadataText}" />
                    </Grid>
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
            <Button x:Name="VolumeButton"
                    Height="36"
                    MinWidth="72">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon Glyph="&#xE767;" FontSize="12" />
                <TextBlock x:Name="VolumeButtonValueText"
                           Text="100%"
                           VerticalAlignment="Center" />
              </StackPanel>
              <Button.Flyout>
                <Flyout Placement="Top">
                  <StackPanel Width="260" Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock x:Name="VolumeFlyoutTitle"
                                 VerticalAlignment="Center"
                                 FontWeight="SemiBold" />
                      <TextBlock x:Name="VolumeValueText"
                                 Grid.Column="1"
                                 Text="100%"
                                 VerticalAlignment="Center" />
                    </Grid>
                    <Slider x:Name="VolumeSlider"
                            Minimum="0"
                            Maximum="100"
                            Value="100"
                            StepFrequency="1"
                            SmallChange="1"
                            LargeChange="10"
                            ValueChanged="VolumeSlider_ValueChanged" />
                    <Grid ColumnDefinitions="Auto,*,Auto,*,Auto">
                      <TextBlock Text="0%" Style="{StaticResource MetadataText}" />
                      <TextBlock Grid.Column="2"
                                 Text="50%"
                                 Style="{StaticResource MetadataText}" />
                      <TextBlock Grid.Column="4"
                                 Text="100%"
                                 Style="{StaticResource MetadataText}" />
                    </Grid>
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
          </StackPanel>

          <StackPanel x:Name="CenterPlaybackControls"
                      Grid.Column="1"
                      Orientation="Horizontal"
                      Spacing="4"
                      HorizontalAlignment="Center">
            <Button x:Name="PreviousChapterButton"
                    Width="48"
                    Height="36"
                    Click="PreviousChapterButton_Click">
              <FontIcon Glyph="&#xE892;" FontSize="12" />
            </Button>
            <Button x:Name="PreviousJumpButton"
                    Width="44"
                    Height="36"
                    Click="PreviousJumpButton_Click">
              <FontIcon Glyph="&#xE100;" FontSize="12" />
            </Button>
            <Button x:Name="PlayPauseButton"
                    Width="44"
                    Height="36"
                    Click="PlayPauseButton_Click">
              <FontIcon x:Name="PlayPauseIcon"
                        Glyph="&#xE768;"
                        FontSize="12" />
            </Button>
            <Button x:Name="NextJumpButton"
                    Width="44"
                    Height="36"
                    Click="NextJumpButton_Click">
              <FontIcon Glyph="&#xE101;" FontSize="12" />
            </Button>
            <Button x:Name="NextChapterButton"
                    Width="48"
                    Height="36"
                    Click="NextChapterButton_Click">
              <FontIcon Glyph="&#xE893;" FontSize="12" />
            </Button>
          </StackPanel>

          <StackPanel x:Name="RightPlaybackControls"
                      Grid.Column="2"
                      Orientation="Horizontal"
                      Spacing="4"
                      HorizontalAlignment="Right">
            <Button x:Name="SidebarToggleButton"
                    Width="44"
                    Height="36"
                    Click="SidebarToggleButton_Click">
              <SymbolIcon x:Name="SidebarToggleIcon" Symbol="ClosePane" />
            </Button>
            <Button x:Name="FullscreenButton"
                    Width="44"
                    Height="36"
                    Click="FullscreenButton_Click">
              <FontIcon x:Name="FullscreenIcon"
                        Glyph="&#xE740;"
                        FontSize="12" />
            </Button>
          </StackPanel>
        </Grid>
      </Grid>
          </Grid>

          <Border x:Name="SidebarDismissLayer"
                  Background="Transparent"
                  Visibility="Collapsed"
                  PointerPressed="SidebarDismissLayer_PointerPressed" />
        </Grid>
      </SplitView.Content>

      <SplitView.Pane>
        <Border x:Name="PlayerSidebar"
                Width="300"
                Background="{ThemeResource AppTransientSurfaceBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,0,0,0">
      <Grid Padding="16"
            RowDefinitions="Auto,Auto,*">
        <StackPanel>
          <TextBlock x:Name="QueueTitle" Style="{StaticResource SectionTitleText}" />
          <TextBlock x:Name="QueueSubtitle" Style="{StaticResource MetadataText}" />
        </StackPanel>

        <ListView x:Name="PlayerSectionList"
                  Grid.Row="1"
                  Margin="0,10,0,10"
                  SelectedIndex="0"
                  SelectionChanged="PlayerSectionList_SelectionChanged"
                  IsItemClickEnabled="True"
                  SelectionMode="Single"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.HorizontalScrollMode="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                  ScrollViewer.VerticalScrollMode="Disabled">
          <ListView.ItemsPanel>
            <ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
          </ListView.ItemsPanel>
          <ListView.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}"
                         Margin="8,2"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>

        <ListView x:Name="QueueList"
                  Grid.Row="2"
                  SelectionMode="Single"
                  SelectedIndex="-1"
                  SelectionChanged="QueueList_SelectionChanged"
                  ItemContainerStyle="{StaticResource SourceListItemStyle}">
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="models:PlaybackQueueItemModel">
              <Grid Height="58" ColumnDefinitions="44,*">
                <TextBlock Text="{x:Bind Number}"
                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">
                  <TextBlock Text="{x:Bind Title}" Style="{StaticResource CardTitleText}" />
                  <TextBlock Text="{x:Bind Status}" Style="{StaticResource MetadataText}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>

        <StackPanel x:Name="TracksPanel"
                    Grid.Row="2"
                    Visibility="Collapsed"
                    Spacing="12"
                    Margin="0,4,0,0">
          <TextBlock x:Name="SubtitleTrackLabel"
                     Style="{StaticResource CardTitleText}" />
          <ComboBox x:Name="SubtitleTrackCombo"
                    HorizontalAlignment="Stretch"
                    controls:TransientComboBoxTheme.Apply="True"
                    SelectionChanged="SubtitleTrackCombo_SelectionChanged" />
          <Grid Margin="0,2,0,0"
                ColumnDefinitions="*,Auto">
            <TextBlock x:Name="PrimarySubtitlePositionLabel"
                       Style="{StaticResource MetadataText}"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="PrimarySubtitlePositionValueText"
                       Grid.Column="1"
                       Style="{StaticResource MetadataText}"
                       VerticalAlignment="Center" />
          </Grid>
          <Slider x:Name="PrimarySubtitlePositionSlider"
                  Minimum="0"
                  Maximum="90"
                  StepFrequency="1"
                  ValueChanged="PrimarySubtitlePositionSlider_ValueChanged" />

          <TextBlock x:Name="SecondarySubtitleTrackLabel"
                     Margin="0,6,0,0"
                     Style="{StaticResource CardTitleText}" />
          <ComboBox x:Name="SecondarySubtitleCombo"
                    HorizontalAlignment="Stretch"
                    controls:TransientComboBoxTheme.Apply="True"
                    SelectionChanged="SecondarySubtitleCombo_SelectionChanged" />
          <Grid Margin="0,2,0,0"
                ColumnDefinitions="*,Auto">
            <TextBlock x:Name="SecondarySubtitlePositionLabel"
                       Style="{StaticResource MetadataText}"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="SecondarySubtitlePositionValueText"
                       Grid.Column="1"
                       Style="{StaticResource MetadataText}"
                       VerticalAlignment="Center" />
          </Grid>
          <Slider x:Name="SecondarySubtitlePositionSlider"
                  Minimum="0"
                  Maximum="90"
                  StepFrequency="1"
                  ValueChanged="SecondarySubtitlePositionSlider_ValueChanged" />

          <TextBlock x:Name="AudioTrackLabel"
                     Margin="0,6,0,0"
                     Style="{StaticResource CardTitleText}" />
          <ComboBox x:Name="AudioTrackCombo"
                    HorizontalAlignment="Stretch"
                    controls:TransientComboBoxTheme.Apply="True"
                    SelectionChanged="AudioTrackCombo_SelectionChanged" />
        </StackPanel>
      </Grid>
        </Border>
      </SplitView.Pane>
    </SplitView>
  </Grid>
</UserControl>
