<UserControl x:Class="Eizo.Views.AboutView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer><Grid MaxWidth="1200" Margin="32" HorizontalAlignment="Stretch" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="16">
  <TextBlock x:Name="PageTitle" Style="{StaticResource PageTitleText}"/>
  <Border Grid.Row="1" Style="{StaticResource SectionCardStyle}"><StackPanel Spacing="14">
   <Grid ColumnDefinitions="76,*,Auto"><Border Width="58" Height="58" CornerRadius="12" Background="{ThemeResource EizoSelectionBrush}"><TextBlock Text="E" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center"><TextBlock Text="映藏 Eizo" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="AboutDescription" Style="{StaticResource MetadataText}"/></StackPanel><Button Grid.Column="2" x:Name="PreviewBadge" Style="{StaticResource CompactActionButton}" IsEnabled="False"/></Grid>
   <Border Style="{StaticResource InnerCardStyle}"><Grid Padding="14" ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto"><StackPanel><TextBlock x:Name="DisplayVersionLabel" Style="{StaticResource MetadataText}"/><TextBlock Text="v0.1 Preview" Style="{StaticResource CardTitleText}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock x:Name="InternalVersionLabel" Style="{StaticResource MetadataText}"/><TextBlock Text="0.1-preview" Style="{StaticResource CardTitleText}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock x:Name="ArchitectureLabel" Style="{StaticResource MetadataText}"/><TextBlock Text="x64" Style="{StaticResource CardTitleText}"/></StackPanel><StackPanel Grid.Row="1" Margin="0,12,0,0"><TextBlock x:Name="ChannelLabel" Style="{StaticResource MetadataText}"/><TextBlock Text="Preview" Style="{StaticResource CardTitleText}"/></StackPanel><StackPanel Grid.Row="1" Grid.Column="1" Margin="0,12,0,0"><TextBlock x:Name="PublisherLabel" Style="{StaticResource MetadataText}"/><TextBlock Text="Eizo" Style="{StaticResource CardTitleText}"/></StackPanel><StackPanel Grid.Row="1" Grid.Column="2" Margin="0,12,0,0"><TextBlock x:Name="TechLabel" Style="{StaticResource MetadataText}"/><TextBlock Text="C# · WinUI 3 · Windows App SDK" Style="{StaticResource CardTitleText}"/></StackPanel></Grid></Border>
   <TextBlock Text="© 2026 Eizo contributors" Style="{StaticResource MetadataText}"/>
  </StackPanel></Border>
  <Border Grid.Row="2" Style="{StaticResource SectionCardStyle}"><StackPanel Spacing="14">
   <TextBlock x:Name="UpdateTitle" Style="{StaticResource SectionTitleText}"/>
   <Border Style="{StaticResource InnerCardStyle}"><Grid Padding="14" ColumnDefinitions="*,*,*,*,*,Auto" ColumnSpacing="14"><StackPanel><TextBlock Text="Eizo" Style="{StaticResource CardTitleText}"/><TextBlock x:Name="ApplicationUpdateLabel" Style="{StaticResource MetadataText}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock x:Name="CurrentVersionLabel" Style="{StaticResource MetadataText}"/><TextBlock Text="v0.1 Preview" Style="{StaticResource BodyText}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock x:Name="AvailableVersionLabel" Style="{StaticResource MetadataText}"/><TextBlock Text="—" Style="{StaticResource BodyText}"/></StackPanel><StackPanel Grid.Column="3"><TextBlock x:Name="UpdateSourceLabel" Style="{StaticResource MetadataText}"/><TextBlock Text="GitHub Releases" Style="{StaticResource BodyText}"/></StackPanel><StackPanel Grid.Column="4"><TextBlock x:Name="UpdateStatusLabel" Style="{StaticResource MetadataText}"/><TextBlock x:Name="NotCheckedText" Style="{StaticResource BodyText}"/></StackPanel><StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="8"><Button x:Name="ReleaseNotesButton" Style="{StaticResource CompactActionButton}"/><Button x:Name="CheckUpdateButton" Style="{StaticResource CompactActionButton}"/></StackPanel></Grid></Border>
   <TextBlock x:Name="IndependentComponentsTitle" Style="{StaticResource CardTitleText}"/>
   <Border Style="{StaticResource InnerCardStyle}"><Grid Padding="14" ColumnDefinitions="*,*,*,*,*,Auto" ColumnSpacing="14"><StackPanel><TextBlock x:Name="PlayerCoreTitle" Style="{StaticResource CardTitleText}"/><TextBlock x:Name="IndependentUpdateLabel" Style="{StaticResource MetadataText}"/></StackPanel><TextBlock Grid.Column="1" Text="1.0.0" VerticalAlignment="Center" Style="{StaticResource BodyText}"/><TextBlock Grid.Column="2" Text="—" VerticalAlignment="Center" Style="{StaticResource BodyText}"/><TextBlock Grid.Column="3" Text="GitHub Releases" VerticalAlignment="Center" Style="{StaticResource BodyText}"/><TextBlock Grid.Column="4" x:Name="NotCheckedComponentText" VerticalAlignment="Center" Style="{StaticResource BodyText}"/><StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="8"><Button x:Name="CoreReleaseNotesButton" Style="{StaticResource CompactActionButton}"/><Button x:Name="CoreCheckUpdateButton" Style="{StaticResource CompactActionButton}"/></StackPanel></Grid></Border>
  </StackPanel></Border>
  <Border Grid.Row="3" Style="{StaticResource SectionCardStyle}"><StackPanel Spacing="14"><TextBlock x:Name="ProjectTitle" Style="{StaticResource SectionTitleText}"/><Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
   <Border Style="{StaticResource InnerCardStyle}"><StackPanel Padding="14" Spacing="6"><TextBlock Text="GitHub" Style="{StaticResource CardTitleText}"/><TextBlock x:Name="GitHubDescription" Style="{StaticResource MetadataText}" TextWrapping="Wrap"/><Button x:Name="OpenRepositoryButton" Style="{StaticResource CompactActionButton}" HorizontalAlignment="Left"/></StackPanel></Border>
   <Border Grid.Column="1" Style="{StaticResource InnerCardStyle}"><StackPanel Padding="14" Spacing="6"><TextBlock Text="Releases" Style="{StaticResource CardTitleText}"/><TextBlock x:Name="ReleasesDescription" Style="{StaticResource MetadataText}" TextWrapping="Wrap"/><Button x:Name="OpenReleasesButton" Style="{StaticResource CompactActionButton}" HorizontalAlignment="Left"/></StackPanel></Border>
   <Border Grid.Column="2" Style="{StaticResource InnerCardStyle}"><StackPanel Padding="14" Spacing="6"><TextBlock x:Name="PrivacyTitle" Style="{StaticResource CardTitleText}"/><TextBlock x:Name="PrivacyDescription" Style="{StaticResource MetadataText}" TextWrapping="Wrap"/><Button x:Name="OpenPrivacyButton" Style="{StaticResource CompactActionButton}" HorizontalAlignment="Left"/></StackPanel></Border>
  </Grid></StackPanel></Border>
 </Grid></ScrollViewer>
</UserControl>
