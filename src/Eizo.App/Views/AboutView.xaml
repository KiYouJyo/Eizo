<UserControl x:Class="Eizo.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer Background="Transparent"
                HorizontalScrollMode="Disabled"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalContentAlignment="Stretch"
                VerticalScrollBarVisibility="Auto">
    <Grid x:Name="AboutRoot"
          Padding="24,16,24,32"
          HorizontalAlignment="Stretch"
          UseLayoutRounding="True">
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup>
          <VisualState x:Name="AboutCompact">
            <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter Target="MetadataColumn0.(Grid.Row)" Value="0" />
              <Setter Target="MetadataColumn0.(Grid.Column)" Value="0" />
              <Setter Target="MetadataColumn1.(Grid.Row)" Value="1" />
              <Setter Target="MetadataColumn1.(Grid.Column)" Value="0" />
              <Setter Target="MetadataColumn2.(Grid.Row)" Value="2" />
              <Setter Target="MetadataColumn2.(Grid.Column)" Value="0" />

              <Setter Target="RepositoryCard.(Grid.Row)" Value="0" />
              <Setter Target="RepositoryCard.(Grid.Column)" Value="0" />
              <Setter Target="ReleasesCard.(Grid.Row)" Value="1" />
              <Setter Target="ReleasesCard.(Grid.Column)" Value="0" />
              <Setter Target="PrivacyCard.(Grid.Row)" Value="2" />
              <Setter Target="PrivacyCard.(Grid.Column)" Value="0" />
            </VisualState.Setters>
          </VisualState>

          <VisualState x:Name="AboutWide">
            <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="900" /></VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter Target="MetadataColumn0.(Grid.Row)" Value="0" />
              <Setter Target="MetadataColumn0.(Grid.Column)" Value="0" />
              <Setter Target="MetadataColumn1.(Grid.Row)" Value="0" />
              <Setter Target="MetadataColumn1.(Grid.Column)" Value="1" />
              <Setter Target="MetadataColumn2.(Grid.Row)" Value="0" />
              <Setter Target="MetadataColumn2.(Grid.Column)" Value="2" />

              <Setter Target="RepositoryCard.(Grid.Row)" Value="0" />
              <Setter Target="RepositoryCard.(Grid.Column)" Value="0" />
              <Setter Target="ReleasesCard.(Grid.Row)" Value="0" />
              <Setter Target="ReleasesCard.(Grid.Column)" Value="1" />
              <Setter Target="PrivacyCard.(Grid.Row)" Value="0" />
              <Setter Target="PrivacyCard.(Grid.Column)" Value="2" />
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>

      <StackPanel Spacing="18"
                  HorizontalAlignment="Stretch">
        <TextBlock x:Name="PageTitle"
                   Style="{StaticResource PageTitleText}" />

        <Border Style="{StaticResource SettingsSectionCardStyle}">
          <StackPanel Spacing="14">
            <Grid ColumnDefinitions="58,16,*,Auto"
                  MinHeight="58">
              <Border Width="58"
                      Height="58"
                      CornerRadius="12"
                      Background="{ThemeResource EizoSelectionBrush}">
                <TextBlock Text="E"
                           FontSize="28"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
              </Border>

              <StackPanel Grid.Column="2"
                          VerticalAlignment="Center"
                          Spacing="2">
                <TextBlock Text="映藏 Eizo"
                           FontSize="22"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="AboutDescription"
                           Style="{StaticResource BodyText}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />
              </StackPanel>

              <Button x:Name="PreviewBadge"
                      Grid.Column="3"
                      Style="{StaticResource CompactActionButton}"
                      IsEnabled="False" />
            </Grid>

            <Border Style="{StaticResource SettingsInnerCardStyle}"
                    Padding="14">
              <Grid x:Name="MetadataGrid"
                    ColumnDefinitions="*,*,*"
                    RowDefinitions="Auto,Auto,Auto"
                    ColumnSpacing="24"
                    RowSpacing="14">
                <StackPanel x:Name="MetadataColumn0"
                            Spacing="10">
                  <StackPanel>
                    <TextBlock x:Name="DisplayVersionLabel" Style="{StaticResource SettingsDescriptionStyle}" />
                    <TextBlock Text="v0.1 Preview" />
                  </StackPanel>
                  <StackPanel>
                    <TextBlock x:Name="ChannelLabel" Style="{StaticResource SettingsDescriptionStyle}" />
                    <TextBlock Text="Preview" />
                  </StackPanel>
                </StackPanel>

                <StackPanel x:Name="MetadataColumn1"
                            Grid.Row="1"
                            Spacing="10">
                  <StackPanel>
                    <TextBlock x:Name="InternalVersionLabel" Style="{StaticResource SettingsDescriptionStyle}" />
                    <TextBlock Text="0.1-preview" />
                  </StackPanel>
                  <StackPanel>
                    <TextBlock x:Name="PublisherLabel" Style="{StaticResource SettingsDescriptionStyle}" />
                    <TextBlock Text="Eizo" />
                  </StackPanel>
                </StackPanel>

                <StackPanel x:Name="MetadataColumn2"
                            Grid.Row="2"
                            Spacing="10">
                  <StackPanel>
                    <TextBlock x:Name="ArchitectureLabel" Style="{StaticResource SettingsDescriptionStyle}" />
                    <TextBlock Text="x64" />
                  </StackPanel>
                  <StackPanel>
                    <TextBlock x:Name="TechLabel" Style="{StaticResource SettingsDescriptionStyle}" />
                    <TextBlock Text="C# · WinUI 3 · Windows App SDK"
                               TextWrapping="Wrap" />
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>

            <TextBlock Text="© 2026 Eizo contributors"
                       Style="{StaticResource MetadataText}" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource SettingsSectionCardStyle}">
          <StackPanel Spacing="14">
            <TextBlock x:Name="UpdateTitle"
                       Style="{StaticResource SectionTitleText}" />

            <Border Style="{StaticResource SettingsInnerCardStyle}"
                    Padding="14">
              <ScrollViewer HorizontalScrollMode="Auto"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollMode="Disabled"
                            VerticalScrollBarVisibility="Disabled">
                <Grid MinWidth="900"
                      MinHeight="44"
                      ColumnDefinitions="2*,110,32,110,150,130,Auto,Auto"
                      ColumnSpacing="10">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Eizo"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="ApplicationUpdateLabel"
                               Style="{StaticResource MetadataText}" />
                  </StackPanel>

                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="CurrentVersionLabel" Style="{StaticResource MetadataText}" />
                    <TextBlock Text="v0.1 Preview" />
                  </StackPanel>

                  <TextBlock Grid.Column="2"
                             Text="→"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                  <StackPanel Grid.Column="3" VerticalAlignment="Center">
                    <TextBlock x:Name="AvailableVersionLabel" Style="{StaticResource MetadataText}" />
                    <TextBlock Text="—" />
                  </StackPanel>

                  <StackPanel Grid.Column="4" VerticalAlignment="Center">
                    <TextBlock x:Name="UpdateSourceLabel" Style="{StaticResource MetadataText}" />
                    <TextBlock Text="GitHub Releases" />
                  </StackPanel>

                  <StackPanel Grid.Column="5" VerticalAlignment="Center">
                    <TextBlock x:Name="UpdateStatusLabel" Style="{StaticResource MetadataText}" />
                    <TextBlock x:Name="NotCheckedText" TextWrapping="Wrap" />
                  </StackPanel>

                  <Button x:Name="ReleaseNotesButton"
                          Grid.Column="6"
                          MinWidth="96"
                          VerticalAlignment="Center" />
                  <Button x:Name="CheckUpdateButton"
                          Grid.Column="7"
                          MinWidth="108"
                          VerticalAlignment="Center" />
                </Grid>
              </ScrollViewer>
            </Border>

            <TextBlock x:Name="IndependentComponentsTitle"
                       Style="{StaticResource BodyText}"
                       FontWeight="SemiBold" />

            <Border Style="{StaticResource SettingsInnerCardStyle}"
                    Padding="14">
              <ScrollViewer HorizontalScrollMode="Auto"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollMode="Disabled"
                            VerticalScrollBarVisibility="Disabled">
                <Grid MinWidth="760"
                      MinHeight="44"
                      ColumnDefinitions="2*,110,110,170,140,Auto,Auto"
                      ColumnSpacing="10">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="PlayerCoreTitle" FontWeight="SemiBold" />
                    <TextBlock x:Name="IndependentUpdateLabel" Style="{StaticResource MetadataText}" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="1.0.0" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="—" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="3" Text="GitHub Releases" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="4" x:Name="NotCheckedComponentText" VerticalAlignment="Center" />
                  <Button x:Name="CoreReleaseNotesButton"
                          Grid.Column="5"
                          MinWidth="96"
                          VerticalAlignment="Center" />
                  <Button x:Name="CoreCheckUpdateButton"
                          Grid.Column="6"
                          MinWidth="108"
                          VerticalAlignment="Center" />
                </Grid>
              </ScrollViewer>
            </Border>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource SettingsSectionCardStyle}"
                Margin="0,0,0,24">
          <StackPanel Spacing="14">
            <TextBlock x:Name="ProjectTitle"
                       Style="{StaticResource SectionTitleText}" />

            <Grid x:Name="ProjectLinksGrid"
                  ColumnDefinitions="*,*,*"
                  RowDefinitions="Auto,Auto,Auto"
                  ColumnSpacing="12"
                  RowSpacing="12">
              <Border x:Name="RepositoryCard"
                      Style="{StaticResource SettingsInnerCardStyle}"
                      Padding="14">
                <Grid RowDefinitions="Auto,Auto,16,Auto">
                  <TextBlock Text="GitHub" FontSize="16" FontWeight="SemiBold" />
                  <TextBlock x:Name="GitHubDescription"
                             Grid.Row="1"
                             Style="{StaticResource SettingsDescriptionStyle}" />
                  <Button x:Name="OpenRepositoryButton"
                          Grid.Row="3"
                          HorizontalAlignment="Left" />
                </Grid>
              </Border>

              <Border x:Name="ReleasesCard"
                      Grid.Row="1"
                      Style="{StaticResource SettingsInnerCardStyle}"
                      Padding="14">
                <Grid RowDefinitions="Auto,Auto,16,Auto">
                  <TextBlock Text="Releases" FontSize="16" FontWeight="SemiBold" />
                  <TextBlock x:Name="ReleasesDescription"
                             Grid.Row="1"
                             Style="{StaticResource SettingsDescriptionStyle}" />
                  <Button x:Name="OpenReleasesButton"
                          Grid.Row="3"
                          HorizontalAlignment="Left" />
                </Grid>
              </Border>

              <Border x:Name="PrivacyCard"
                      Grid.Row="2"
                      Style="{StaticResource SettingsInnerCardStyle}"
                      Padding="14">
                <Grid RowDefinitions="Auto,Auto,16,Auto">
                  <TextBlock x:Name="PrivacyTitle"
                             FontSize="16"
                             FontWeight="SemiBold" />
                  <TextBlock x:Name="PrivacyDescription"
                             Grid.Row="1"
                             Style="{StaticResource SettingsDescriptionStyle}" />
                  <Button x:Name="OpenPrivacyButton"
                          Grid.Row="3"
                          HorizontalAlignment="Left" />
                </Grid>
              </Border>
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
