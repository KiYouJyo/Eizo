<Window x:Class="Eizo.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
 <Grid x:Name="WindowRoot" Background="Transparent" UseLayoutRounding="True">
  <Grid RowDefinitions="48,*">
   <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent" ColumnDefinitions="104,*,132" Padding="16,0,12,0">
    <TextBlock Text="Eizo" Style="{StaticResource BodyText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <ScrollViewer Grid.Column="1" Height="32" Margin="0,8,12,8" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" IsTabStop="False">
     <StackPanel Orientation="Horizontal" Spacing="8">
      <StackPanel x:Name="ShellTabItems" Orientation="Horizontal" Spacing="8"/>
      <Button x:Name="ShellNewTabButton" Width="32" Height="32" MinWidth="32" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="7" Click="ShellNewTabButton_Click"><FontIcon Glyph="&#xE710;" FontSize="12"/></Button>
     </StackPanel>
    </ScrollViewer>
   </Grid>
   <NavigationView x:Name="ShellNavigation" Grid.Row="1" Background="Transparent" AlwaysShowHeader="False" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" PaneDisplayMode="Auto" OpenPaneLength="216" CompactPaneLength="48" ItemInvoked="ShellNavigation_ItemInvoked">
    <NavigationView.Resources>
     <Thickness x:Key="NavigationViewBorderThickness">0</Thickness><Thickness x:Key="NavigationViewPaneContentGridMargin">0</Thickness><Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness><Thickness x:Key="NavigationViewMinimalContentGridBorderThickness">0</Thickness>
     <StaticResource x:Key="NavigationViewDefaultPaneBackground" ResourceKey="ShellNavigationPaneBackgroundBrush"/>
    </NavigationView.Resources>
    <NavigationView.MenuItems>
     <NavigationViewItem x:Name="HomeNav" Tag="home" IsSelected="True"><NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;"/></NavigationViewItem.Icon></NavigationViewItem>
     <NavigationViewItem x:Name="CategoryNav" Tag="categories" SelectsOnInvoked="False">
      <NavigationViewItem.Icon><FontIcon Glyph="&#xF0E2;"/></NavigationViewItem.Icon>
      <NavigationViewItem.MenuItems>
       <NavigationViewItem x:Name="AnimeNav" Tag="anime"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8B2;"/></NavigationViewItem.Icon></NavigationViewItem>
       <NavigationViewItem x:Name="MoviesNav" Tag="movies"><NavigationViewItem.Icon><FontIcon Glyph="&#xE714;"/></NavigationViewItem.Icon></NavigationViewItem>
       <NavigationViewItem x:Name="SeriesNav" Tag="series"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8FD;"/></NavigationViewItem.Icon></NavigationViewItem>
      </NavigationViewItem.MenuItems>
     </NavigationViewItem>
     <NavigationViewItem x:Name="SourcesNav" Tag="sources"><NavigationViewItem.Icon><FontIcon Glyph="&#xE753;"/></NavigationViewItem.Icon></NavigationViewItem>
    </NavigationView.MenuItems>
    <NavigationView.FooterMenuItems>
     <NavigationViewItem x:Name="CacheNav" Tag="cache"><NavigationViewItem.Icon><FontIcon Glyph="&#xE7C5;"/></NavigationViewItem.Icon></NavigationViewItem>
     <NavigationViewItem x:Name="AboutNav" Tag="about"><NavigationViewItem.Icon><FontIcon Glyph="&#xE897;"/></NavigationViewItem.Icon></NavigationViewItem>
     <NavigationViewItem x:Name="SettingsNav" Tag="settings"><NavigationViewItem.Icon><FontIcon Glyph="&#xE713;"/></NavigationViewItem.Icon></NavigationViewItem>
    </NavigationView.FooterMenuItems>
    <ContentControl x:Name="MainContent" Background="Transparent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
   </NavigationView>
  </Grid>
 </Grid>
</Window>
